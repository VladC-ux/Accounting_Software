@model Accounting_Software.ViewModel.UserViewModel
@{
    Layout = "_FintegraLayout";
    ViewBag.ActivePage = "income";
    ViewBag.PageTitle = Localizer["Create User"].Value;
    ViewBag.PageHeading = Localizer["Create User"].Value;
    ViewBag.PageSubtitle = Localizer["Add the main account holder to the system"].Value;
}

@section Styles {
<style>
    .form-wrap{max-width:560px;}
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .fg{margin-bottom:18px;}
    .fg label{display:block;font-size:.74rem;font-weight:700;color:var(--muted);margin-bottom:7px;text-transform:uppercase;letter-spacing:.05em;}
    .fg input{width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:12px;font-size:.92rem;font-family:inherit;background:#fff;color:var(--text);transition:all .15s;}
    .fg input:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 4px rgba(45,106,79,.12);}
    .invalid-feedback{color:var(--red);font-size:.78rem;margin-top:5px;display:block;}

    .actions{display:flex;gap:10px;margin-top:22px;padding-top:18px;border-top:1px solid var(--border-soft);}

    .success-box{
        background:var(--green-soft);border:1px solid var(--green-tint);
        border-radius:14px;padding:18px 20px;color:var(--green-dark);
        display:flex;gap:12px;align-items:center;font-size:.92rem;
    }
    .success-box i{font-size:1.6rem;color:var(--green);flex-shrink:0;}
</style>
}

<a class="back-link" asp-controller="Seller" asp-action="Index">
    <i class="fas fa-arrow-left"></i> @Localizer["Back to Sellers"]
</a>

<div class="form-wrap">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3><i class="fas fa-user-plus" style="color:var(--green);margin-right:6px;"></i> @Localizer["Create user account"]</h3>
                <div class="hd-sub">@Localizer["Only one main user account is allowed"]</div>
            </div>
        </div>

        @if (ViewBag.UserCreated == true)
        {
            <div class="success-box">
                <i class="fas fa-check-circle"></i>
                <div>
                    <strong>@Localizer["Success!"]</strong> @Localizer["The user has been created. You cannot create another one."]
                </div>
            </div>
        }
        else
        {
            <form method="post" asp-action="AddUser" asp-controller="User">
                <div class="fg">
                    <label for="Name">@Localizer["Name"]</label>
                    <input type="text" id="Name" asp-for="Name" placeholder="@Localizer["Enter your name"]" required />
                    <span asp-validation-for="Name" class="invalid-feedback"></span>
                </div>

                <div class="actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> @Localizer["Create User"]
                    </button>
                    <a class="btn btn-ghost" href="@Url.Action("Index", "Seller")">
                        <i class="fas fa-times"></i> @Localizer["Cancel"]
                    </a>
                </div>
            </form>
        }
    </div>
</div>
