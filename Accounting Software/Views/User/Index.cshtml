@using System.Globalization
@model Accounting_Software.ViewModel.UserViewModel
@{
    Layout = "_FintegraLayout";
    var inv = CultureInfo.InvariantCulture;
    var enCulture = new CultureInfo("en-US");

    var recentTx = ViewBag.RecentTx as List<Accounting_Software.ViewModel.TransactionHistoryViewModel> ?? new();
    decimal totalSpent     = ViewBag.TotalSpent ?? 0m;
    decimal totalEarned    = ViewBag.TotalEarned ?? 0m;
    decimal totalDeposited = ViewBag.TotalDeposited ?? 0m;
    decimal netProfit      = totalEarned - totalSpent;
    string email           = ViewBag.Email ?? "";

    string FmtMoney(decimal v) => v.ToString("N2", inv);

    ViewBag.ActivePage = "income";
    ViewBag.PageTitle = "Income";
    ViewBag.PageHeading = "My Account";
    ViewBag.PageSubtitle = (Model.Name ?? "User") + (string.IsNullOrEmpty(email) ? "" : " · " + email);
}

@section Styles {
<style>
    .balance-row{
        display:grid;grid-template-columns:1.1fr 1fr;gap:18px;margin-bottom:22px;
    }
    .balance-card{
        background:linear-gradient(135deg,#2D6A4F 0%,#52B788 100%);
        color:#fff;border-radius:var(--r-lg);padding:28px 30px;
        box-shadow:0 12px 30px rgba(45,106,79,.22);position:relative;overflow:hidden;
    }
    .balance-card::before{
        content:'';position:absolute;top:-50px;right:-50px;width:220px;height:220px;
        background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%);border-radius:50%;
    }
    .balance-lbl{font-size:.74rem;text-transform:uppercase;letter-spacing:.06em;opacity:.85;font-weight:600;}
    .balance-val{font-size:2.6rem;font-weight:800;letter-spacing:-.025em;margin-top:8px;line-height:1;}
    .balance-sub{font-size:.84rem;opacity:.75;margin-top:8px;}
    .balance-meta{display:flex;align-items:center;gap:18px;margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.18);font-size:.8rem;opacity:.85;}
    .balance-meta i{margin-right:6px;}

    .topup-card{
        background:var(--card);border-radius:var(--r-lg);padding:24px 26px;
        box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:16px;
    }
    .topup-card h3{font-size:1rem;font-weight:700;letter-spacing:-.01em;}
    .topup-card .sub{font-size:.78rem;color:var(--muted);margin-top:2px;}
    .topup-form{display:flex;gap:10px;align-items:stretch;}
    .topup-form input[type=number]{
        flex:1;padding:11px 14px;border:1px solid var(--border-soft);border-radius:11px;
        font-family:inherit;font-size:.95rem;font-weight:600;color:var(--text);
        background:var(--bg);transition:all .15s;outline:none;
    }
    .topup-form input[type=number]:focus{border-color:var(--green);background:#fff;box-shadow:0 0 0 4px rgba(45,106,79,.1);}
    .topup-form .btn-topup{
        background:var(--green);color:#fff;border:none;border-radius:11px;
        padding:0 22px;font-weight:700;font-size:.86rem;cursor:pointer;
        display:inline-flex;align-items:center;gap:8px;transition:all .15s;
    }
    .topup-form .btn-topup:hover{background:var(--green-dark);transform:translateY(-1px);box-shadow:0 6px 14px rgba(45,106,79,.25);}
    .preset-row{display:flex;gap:8px;flex-wrap:wrap;}
    .preset-btn{
        background:var(--green-soft);border:1px solid transparent;border-radius:9px;
        padding:6px 14px;font-size:.8rem;font-weight:700;color:var(--green);cursor:pointer;
        font-family:inherit;transition:all .15s;
    }
    .preset-btn:hover{background:var(--green);color:#fff;}

    .stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:22px;}
    .stat{
        background:var(--card);border-radius:var(--r-lg);padding:20px 22px;
        box-shadow:var(--shadow-sm);position:relative;
    }
    .stat-ico{
        width:42px;height:42px;border-radius:12px;display:grid;place-items:center;
        font-size:1rem;margin-bottom:14px;
    }
    .stat-ico.red{background:var(--red-soft);color:var(--red);}
    .stat-ico.green{background:var(--green-tint);color:var(--green);}
    .stat-ico.orange{background:var(--orange-soft);color:var(--orange);}
    .stat-ico.blue{background:var(--blue-soft);color:var(--blue);}
    .stat-lbl{font-size:.74rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:600;}
    .stat-val{font-size:1.45rem;font-weight:800;letter-spacing:-.02em;margin-top:6px;}
    .stat-val.c-red{color:var(--red);}
    .stat-val.c-green{color:var(--green);}
    .stat-val.c-orange{color:var(--orange);}
    .stat-val.c-blue{color:var(--blue);}

    .alert-row{margin-bottom:16px;}
    .alert{
        border-radius:12px;padding:12px 16px;font-size:.86rem;font-weight:500;
        display:flex;align-items:center;gap:10px;margin-bottom:10px;
    }
    .alert.ok{background:var(--green-tint);color:var(--green);border:1px solid #BCDDC6;}
    .alert.err{background:var(--red-soft);color:var(--red);border:1px solid #F4C5BD;}

    /* TX table */
    .tx-table{width:100%;border-collapse:collapse;font-size:.86rem;}
    .tx-table th{
        text-align:left;padding:10px 16px;font-size:.7rem;color:var(--muted);
        text-transform:uppercase;letter-spacing:.05em;font-weight:700;
        border-bottom:1px solid var(--border-soft);
    }
    .tx-table td{padding:14px 16px;border-bottom:1px solid var(--border-soft);}
    .tx-table tr:last-child td{border-bottom:none;}
    .tx-table tr:hover td{background:var(--green-soft);}
    .badge{
        display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:99px;
        font-size:.72rem;font-weight:700;
    }
    .badge.buy{background:var(--red-soft);color:var(--red);}
    .badge.sale{background:var(--green-tint);color:var(--green);}
    .badge.dep{background:var(--orange-soft);color:var(--orange);}
    .tx-amt{font-weight:700;font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap;}
    .tx-amt.neg{color:var(--red);}
    .tx-amt.pos{color:var(--green);}
    .tx-amt.dep{color:var(--orange);}
    .muted{color:var(--muted);}

    @@media(max-width:1100px){
        .balance-row{grid-template-columns:1fr;}
        .stats-row{grid-template-columns:repeat(2,1fr);}
    }
    @@media(max-width:600px){
        .stats-row{grid-template-columns:1fr;}
        .balance-val{font-size:2rem;}
    }
</style>
}

@if (TempData["Success"] != null)
{
    <div class="alert-row">
        <div class="alert ok"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-row">
        <div class="alert err"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
    </div>
}

<div class="balance-row">
    <div class="balance-card">
        <div class="balance-lbl">Current Balance</div>
        <div class="balance-val">@FmtMoney(Model.Balance)</div>
        <div class="balance-sub">Available funds for purchases</div>
        <div class="balance-meta">
            <span><i class="fas fa-user"></i> @Model.Name</span>
            @if (!string.IsNullOrEmpty(email))
            {
                <span><i class="fas fa-envelope"></i> @email</span>
            }
        </div>
    </div>

    <div class="topup-card">
        <div>
            <h3>Add funds</h3>
            <div class="sub">Top up your account balance</div>
        </div>
        <form asp-action="TopUp" asp-controller="User" method="post">
            <div class="topup-form">
                <input type="number" name="amount" id="topupAmount"
                       placeholder="0.00" step="0.01" min="0.01" required />
                <button type="submit" class="btn-topup">
                    <i class="fas fa-plus-circle"></i> Top Up
                </button>
            </div>
            <div class="preset-row" style="margin-top:12px;">
                <button type="button" class="preset-btn" onclick="setAmount(50)">+50</button>
                <button type="button" class="preset-btn" onclick="setAmount(100)">+100</button>
                <button type="button" class="preset-btn" onclick="setAmount(250)">+250</button>
                <button type="button" class="preset-btn" onclick="setAmount(500)">+500</button>
                <button type="button" class="preset-btn" onclick="setAmount(1000)">+1000</button>
            </div>
        </form>
    </div>
</div>

<div class="stats-row">
    <div class="stat">
        <div class="stat-ico orange"><i class="fas fa-piggy-bank"></i></div>
        <div class="stat-lbl">Total Deposited</div>
        <div class="stat-val c-orange">@FmtMoney(totalDeposited)</div>
    </div>
    <div class="stat">
        <div class="stat-ico red"><i class="fas fa-arrow-down"></i></div>
        <div class="stat-lbl">Total Spent</div>
        <div class="stat-val c-red">@FmtMoney(totalSpent)</div>
    </div>
    <div class="stat">
        <div class="stat-ico blue"><i class="fas fa-arrow-up"></i></div>
        <div class="stat-lbl">Total Earned</div>
        <div class="stat-val c-blue">@FmtMoney(totalEarned)</div>
    </div>
    <div class="stat">
        <div class="stat-ico green"><i class="fas fa-chart-line"></i></div>
        <div class="stat-lbl">Net Profit</div>
        <div class="stat-val @(netProfit >= 0 ? "c-green" : "c-red")">@FmtMoney(netProfit)</div>
    </div>
</div>

<div class="card" style="padding:0;">
    <div class="card-hd" style="padding:22px 24px 16px;margin-bottom:0;">
        <div>
            <h3>Recent transactions</h3>
            <div class="hd-sub">Latest movements on your account</div>
        </div>
        <a class="hd-link" asp-controller="User" asp-action="ProductsTransaction" asp-route-id="@Model.Id">
            View all <i class="fas fa-chevron-right"></i>
        </a>
    </div>

    @if (recentTx.Any())
    {
        <table class="tx-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Product</th>
                    <th>Store</th>
                    <th style="text-align:right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in recentTx)
                {
                    <tr>
                        <td class="muted">@t.SoldDate.ToString("dd MMM yyyy", enCulture)</td>
                        <td>
                            @if (t.typeofAction == "Add")
                            {
                                <span class="badge buy"><i class="fas fa-shopping-cart"></i> Purchase</span>
                            }
                            else if (t.typeofAction == "Sale")
                            {
                                <span class="badge sale"><i class="fas fa-tag"></i> Sale</span>
                            }
                            else if (t.typeofAction == "Deposit")
                            {
                                <span class="badge dep"><i class="fas fa-plus"></i> Deposit</span>
                            }
                            else
                            {
                                <span class="badge" style="background:var(--bg);color:var(--muted);">@t.typeofAction</span>
                            }
                        </td>
                        <td><strong>@t.ProductName</strong></td>
                        <td class="muted">@(t.StoreName ?? "—")</td>
                        <td class="tx-amt @(t.typeofAction == "Add" ? "neg" : t.typeofAction == "Sale" ? "pos" : "dep")">
                            @(t.typeofAction == "Add" ? "−" : "+")@FmtMoney(t.typeofAction == "Deposit" ? t.Price : t.Total)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding:48px;text-align:center;color:var(--muted);">
            <i class="fas fa-inbox" style="font-size:1.8rem;color:var(--border);display:block;margin-bottom:10px;"></i>
            <div>No transactions yet</div>
        </div>
    }
</div>

@section Scripts {
<script>
    function setAmount(val) {
        document.getElementById('topupAmount').value = val;
    }
</script>
}
