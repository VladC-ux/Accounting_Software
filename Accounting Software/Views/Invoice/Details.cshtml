@model Accounting_Software.ViewModel.InvoiceViewModel
@{
    Layout = "_FintegraLayout";
    ViewBag.ActivePage = "invoices";
    ViewBag.PageTitle = Localizer["Invoice"].Value + $" {Model.Number}";
    ViewBag.PageHeading = Localizer["Invoice"].Value + $" {Model.Number}";
    ViewBag.PageSubtitle = Model.IssuedAt.ToString("dd MMMM yyyy HH:mm");
    ViewBag.HeaderActions = $@"<a class='btn btn-ghost' href='/Invoice/Index'><i class='fas fa-arrow-left'></i> {Localizer["All invoices"].Value}</a>"
                          + $@"<a class='btn btn-primary' href='/Invoice/Pdf/{Model.Id}' target='_blank'><i class='fas fa-file-pdf'></i> {Localizer["Download PDF"].Value}</a>";
}

@section Styles {
<style>
    .doc-wrap{max-width:920px;}
    .doc{
        background:var(--card);border:1px solid var(--border-soft);border-radius:var(--r-lg);
        padding:36px;box-shadow:var(--shadow-sm);
    }
    .doc-head{
        display:flex;justify-content:space-between;align-items:flex-start;
        border-bottom:1px solid var(--border-soft);padding-bottom:22px;margin-bottom:24px;
        gap:16px;flex-wrap:wrap;
    }
    .doc-title{font-size:1.85rem;font-weight:800;color:var(--green);letter-spacing:-0.02em;}
    .doc-sub{font-size:.85rem;color:var(--muted);margin-top:4px;}
    .doc-meta{text-align:right;}
    .doc-meta .label{font-size:.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;}
    .doc-meta .val{font-size:1.05rem;font-weight:800;color:var(--text);font-family:'JetBrains Mono','Courier New',monospace;}
    .doc-meta .date{font-size:.85rem;color:var(--text);margin-top:6px;}

    .parties{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:22px;}
    @@media(max-width:640px){.parties{grid-template-columns:1fr;}}
    .party .label{font-size:.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;margin-bottom:6px;}
    .party .name{font-size:1rem;font-weight:800;color:var(--text);}
    .party .detail{font-size:.85rem;color:var(--muted);margin-top:3px;}

    table.items{width:100%;border-collapse:collapse;margin-bottom:18px;}
    table.items th{
        background:var(--green-soft);font-size:.7rem;font-weight:700;color:var(--muted);
        text-align:left;padding:10px 12px;text-transform:uppercase;letter-spacing:.05em;
        border-bottom:1px solid var(--border-soft);
    }
    table.items td{padding:13px 12px;border-bottom:1px solid var(--border-soft);font-size:.88rem;vertical-align:top;color:var(--text);}
    table.items td.r{text-align:right;}
    table.items th.r{text-align:right;}
    table.items tr:last-child td{border-bottom:none;}
    .item-name{font-weight:700;color:var(--text);}
    .item-desc{color:var(--muted);font-size:.78rem;margin-top:2px;}

    .totals{display:flex;justify-content:flex-end;margin-top:18px;}
    .totals-box{min-width:300px;}
    .totals-row{display:flex;justify-content:space-between;padding:6px 0;font-size:.92rem;color:var(--text);}
    .totals-row .lbl{color:var(--muted);}
    .totals-total{
        border-top:1px solid var(--border-soft);margin-top:8px;padding-top:14px;
        display:flex;justify-content:space-between;align-items:baseline;
    }
    .totals-total .lbl{font-size:.86rem;font-weight:800;color:var(--text);text-transform:uppercase;letter-spacing:.04em;}
    .totals-total .val{font-size:1.6rem;font-weight:800;color:var(--green);letter-spacing:-.02em;}
</style>
}

<div class="doc-wrap">
    <div class="doc">
        <div class="doc-head">
            <div>
                <div class="doc-title">@Localizer["INVOICE"]</div>
                <div class="doc-sub">StockFlow</div>
            </div>
            <div class="doc-meta">
                <div class="label">@Localizer["Invoice #"]</div>
                <div class="val">@Model.Number</div>
                <div class="label" style="margin-top:8px;">@Localizer["Issued"]</div>
                <div class="date">@Model.IssuedAt.ToString("dd MMM yyyy HH:mm")</div>
            </div>
        </div>

        <div class="parties">
            <div class="party">
                <div class="label">@Localizer["From"]</div>
                <div class="name">@(Model.StoreName ?? "—")</div>
                @if (!string.IsNullOrWhiteSpace(Model.UserName))
                {
                    <div class="detail">@Localizer["Issued by:"] @Model.UserName</div>
                }
            </div>
            <div class="party">
                <div class="label">@Localizer["Bill to"]</div>
                <div class="name">@(string.IsNullOrWhiteSpace(Model.BuyerName) ? Localizer["Walk-in customer"].Value : Model.BuyerName)</div>
                @if (!string.IsNullOrWhiteSpace(Model.BuyerEmail))
                {
                    <div class="detail">@Model.BuyerEmail</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.BuyerPhone))
                {
                    <div class="detail">@Model.BuyerPhone</div>
                }
            </div>
        </div>

        <table class="items">
            <thead>
                <tr>
                    <th style="width:30px;">#</th>
                    <th>@Localizer["Description"]</th>
                    <th class="r" style="width:80px;">@Localizer["Qty"]</th>
                    <th class="r" style="width:120px;">@Localizer["Unit price"]</th>
                    <th class="r" style="width:120px;">@Localizer["Amount"]</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@idx</td>
                        <td>
                            <div class="item-name">@item.ProductName</div>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="item-desc">@item.Description</div>
                            }
                        </td>
                        <td class="r">@item.Count @item.UnitOfMass</td>
                        <td class="r">@item.Price.ToString("N2")</td>
                        <td class="r"><strong>@item.Total.ToString("N2")</strong></td>
                    </tr>
                    idx++;
                }
            </tbody>
        </table>

        <div class="totals">
            <div class="totals-box">
                <div class="totals-row">
                    <span class="lbl">@Localizer["Subtotal"]</span>
                    <span>@Model.Subtotal.ToString("N2")</span>
                </div>
                @if (Model.TaxRate > 0)
                {
                    <div class="totals-row">
                        <span class="lbl">@Localizer["VAT"] (@Model.TaxRate.ToString("N2")%)</span>
                        <span>@Model.TaxAmount.ToString("N2")</span>
                    </div>
                }
                <div class="totals-total">
                    <span class="lbl">@Localizer["Total"]</span>
                    <span class="val">@Model.Total.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>
