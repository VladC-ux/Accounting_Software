@model Accounting_Software.ViewModel.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password – Accounting Software</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.6.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
        }
        .auth-card {
            background: #fff;
            border-radius: 18px;
            padding: 44px 40px 36px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.35);
        }
        .auth-logo { text-align: center; margin-bottom: 28px; }
        .auth-logo .icon-wrap {
            width: 64px; height: 64px; border-radius: 16px;
            background: linear-gradient(135deg, #f093fb, #f5576c);
            display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px;
        }
        .auth-logo .icon-wrap i { font-size: 1.8rem; color: #fff; }
        .auth-logo h1 { font-size: 1.4rem; font-weight: 700; color: #1a1a2e; margin: 0; }
        .auth-logo p { color: #6c757d; font-size: 0.9rem; margin: 4px 0 0; }
        .form-group label { font-weight: 600; font-size: 0.88rem; color: #1a1a2e; margin-bottom: 6px; }
        .form-control {
            border-radius: 10px; border: 1.5px solid #e0e0e0;
            padding: 11px 14px; font-size: 0.95rem; transition: border-color 0.2s;
        }
        .form-control:focus { border-color: #f5576c; box-shadow: 0 0 0 3px rgba(245,87,108,0.15); }
        .input-icon { position: relative; }
        .input-icon i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #aaa; font-size: 0.9rem; }
        .input-icon .form-control { padding-left: 36px; }
        .btn-auth {
            background: linear-gradient(135deg, #f093fb, #f5576c);
            color: #fff; border: none; border-radius: 10px; padding: 12px;
            font-size: 1rem; font-weight: 600; width: 100%; transition: opacity 0.2s, transform 0.15s;
        }
        .btn-auth:hover { opacity: 0.9; transform: translateY(-1px); color: #fff; }
        .back-link {
            display: block; text-align: center; margin-top: 18px;
            color: #667eea; font-size: 0.88rem; text-decoration: none;
        }
        .back-link:hover { text-decoration: underline; }
        .text-danger { font-size: 0.82rem; }
        .success-box {
            background: #e8f5e9; border-radius: 12px; padding: 24px;
            text-align: center; color: #2e7d32;
        }
        .success-box i { font-size: 2.5rem; margin-bottom: 12px; display: block; }
        .success-box h5 { font-weight: 700; }
        .error-box {
            background: #fce4ec; border-radius: 12px; padding: 20px;
            text-align: center; color: #c62828; margin-bottom: 0;
        }
        .error-box i { font-size: 2rem; margin-bottom: 10px; display: block; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <div class="icon-wrap"><i class="fas fa-key"></i></div>
            <h1>Forgot Password</h1>
            <p>Enter your email to receive a reset request</p>
        </div>

        @if (ViewBag.EmailSent == true)
        {
            <div class="success-box">
                <i class="fas fa-envelope-open-text"></i>
                <h5>Check your email!</h5>
                <p style="font-size:0.9rem;margin:0;">
                    A confirmation email has been sent. Open it and click
                    <strong>"Approve &amp; Reset Password"</strong> to proceed.
                </p>
                <p style="font-size:0.82rem;color:#388e3c;margin-top:10px;">The link expires in 1 hour.</p>
            </div>
        }
        else if (ViewBag.EmailError == true)
        {
            <div class="error-box">
                <i class="fas fa-exclamation-circle"></i>
                <h6 style="font-weight:700;">Email Could Not Be Sent</h6>
                <p style="font-size:0.85rem;margin:0;">
                    The email service is not configured correctly.<br/>
                    Please contact your administrator to set up SMTP in <code>appsettings.json</code>.
                </p>
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.88rem;"></div>

                <div class="form-group">
                    <label>Email Address</label>
                    <div class="input-icon">
                        <i class="fas fa-envelope"></i>
                        <input asp-for="Email" class="form-control" placeholder="your@email.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-auth">
                    <i class="fas fa-paper-plane mr-2"></i>Send Reset Request
                </button>
            </form>
        }

        <a asp-action="Login" class="back-link">
            <i class="fas fa-arrow-left mr-1"></i>Back to Login
        </a>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
