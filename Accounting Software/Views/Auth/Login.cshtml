@model Accounting_Software.ViewModel.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — StockFlow</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root{
            --green:#2D6A4F; --green-dark:#1F4D37; --green-light:#52B788; --green-tint:#E8F0E5;
            --green-soft:#F1F6EE;
            --bg:#F7F4EC; --card:#FFFFFF;
            --text:#1A2B23; --muted:#6B7280;
            --border:#E5E7EB; --border-soft:#F1EFE8;
            --red:#D9534F; --red-soft:#FBE5E1;
            --orange:#E89A3C;
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        body{
            background:var(--bg);
            min-height:100vh;display:flex;align-items:center;justify-content:center;
            font-family:'Manrope',system-ui,sans-serif;color:var(--text);
            padding:30px 16px;
            background-image:
                radial-gradient(circle at 15% 20%, rgba(45,106,79,0.10), transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(82,183,136,0.10), transparent 45%);
        }
        .auth-card{
            background:var(--card);border-radius:22px;padding:40px 36px 32px;
            width:100%;max-width:420px;
            box-shadow:0 22px 60px rgba(31,41,55,0.10),0 4px 14px rgba(31,41,55,0.04);
            border:1px solid var(--border-soft);
        }
        .auth-logo{text-align:center;margin-bottom:26px;}
        .auth-logo .icon-wrap{
            width:64px;height:64px;border-radius:18px;
            background:linear-gradient(135deg,var(--green),var(--green-light));
            display:inline-flex;align-items:center;justify-content:center;margin-bottom:14px;
            box-shadow:0 8px 20px rgba(45,106,79,0.30);
        }
        .auth-logo .icon-wrap i{font-size:1.8rem;color:#fff;}
        .auth-logo h1{font-size:1.4rem;font-weight:800;color:var(--text);letter-spacing:-.02em;}
        .auth-logo p{color:var(--muted);font-size:0.88rem;margin:4px 0 0;}

        .form-group{margin-bottom:16px;}
        .form-group label{
            display:block;font-weight:600;font-size:0.78rem;
            color:var(--muted);margin-bottom:6px;
            text-transform:uppercase;letter-spacing:.04em;
        }
        .input-icon{position:relative;}
        .input-icon i{
            position:absolute;left:14px;top:50%;transform:translateY(-50%);
            color:var(--muted);font-size:0.9rem;
        }
        .form-control{
            width:100%;border-radius:12px;border:1.5px solid var(--border);
            padding:12px 14px 12px 40px;font-size:0.92rem;font-family:inherit;
            background:#fff;color:var(--text);transition:all .15s;
        }
        .form-control:focus{
            outline:none;border-color:var(--green);
            box-shadow:0 0 0 4px rgba(45,106,79,0.12);
        }

        .btn-auth{
            background:var(--green);color:#fff;border:none;border-radius:12px;
            padding:13px;font-size:0.95rem;font-weight:700;width:100%;
            cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;
            box-shadow:0 6px 16px rgba(45,106,79,0.28);
            transition:all .15s;
        }
        .btn-auth:hover{background:var(--green-dark);transform:translateY(-1px);box-shadow:0 9px 22px rgba(45,106,79,0.35);}

        .forgot-link{
            display:block;text-align:center;margin-top:18px;
            color:var(--green);font-size:0.85rem;font-weight:600;
            text-decoration:none;
        }
        .forgot-link:hover{text-decoration:underline;}

        .alert-success-custom{
            background:var(--green-soft);border:1px solid var(--green-tint);
            border-radius:12px;color:var(--green-dark);
            font-size:0.88rem;padding:12px 16px;margin-bottom:18px;
            display:flex;align-items:center;gap:8px;
        }
        .text-danger{color:var(--red);font-size:0.78rem;display:block;margin-top:4px;}
        .remember-row{
            display:flex;align-items:center;gap:8px;margin-bottom:20px;
        }
        .remember-row input[type=checkbox]{
            width:16px;height:16px;accent-color:var(--green);
        }
        .remember-row label{
            margin:0;font-weight:500;font-size:0.86rem;color:var(--muted);
            text-transform:none;letter-spacing:0;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <div class="icon-wrap"><i class="fas fa-chart-line"></i></div>
            <h1>StockFlow</h1>
            <p>Sign in to your account</p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert-success-custom"><i class="fas fa-check-circle"></i> @ViewBag.Message</div>
        }

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:12px;"></div>

            <div class="form-group">
                <label>Email</label>
                <div class="input-icon">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="your@email.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Password</label>
                <div class="input-icon">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="remember-row">
                <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                <label for="rememberMe">Remember me for 30 days</label>
            </div>

            <button type="submit" class="btn-auth">
                <i class="fas fa-sign-in-alt"></i> Sign In
            </button>
        </form>

        <a asp-action="ForgotPassword" class="forgot-link">
            <i class="fas fa-key"></i> Forgot password?
        </a>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
