@model Accounting_Software.ViewModel.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Setup Login – Accounting Software</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.6.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            padding: 30px 16px;
        }
        .auth-card {
            background: #fff;
            border-radius: 18px;
            padding: 44px 40px 36px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.35);
        }
        .auth-logo { text-align: center; margin-bottom: 28px; }
        .auth-logo .icon-wrap {
            width: 64px; height: 64px; border-radius: 16px;
            background: linear-gradient(135deg, #fccb90, #d57eeb);
            display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px;
        }
        .auth-logo .icon-wrap i { font-size: 1.8rem; color: #fff; }
        .auth-logo h1 { font-size: 1.4rem; font-weight: 700; color: #1a1a2e; margin: 0; }
        .auth-logo p { color: #6c757d; font-size: 0.9rem; margin: 4px 0 0; }
        .setup-badge {
            background: linear-gradient(135deg, #fccb90, #d57eeb);
            color: #fff; border-radius: 20px; padding: 4px 14px;
            font-size: 0.75rem; font-weight: 700; display: inline-block;
            margin-bottom: 6px; letter-spacing: 0.5px;
        }
        .form-group label { font-weight: 600; font-size: 0.88rem; color: #1a1a2e; margin-bottom: 6px; }
        .form-control {
            border-radius: 10px; border: 1.5px solid #e0e0e0;
            padding: 11px 14px; font-size: 0.95rem; transition: border-color 0.2s;
        }
        .form-control:focus { border-color: #d57eeb; box-shadow: 0 0 0 3px rgba(213,126,235,0.15); }
        .input-icon { position: relative; }
        .input-icon i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #aaa; font-size: 0.9rem; }
        .input-icon .form-control { padding-left: 36px; }
        .btn-auth {
            background: linear-gradient(135deg, #fccb90, #d57eeb);
            color: #fff; border: none; border-radius: 10px; padding: 12px;
            font-size: 1rem; font-weight: 700; width: 100%; transition: opacity 0.2s, transform 0.15s;
        }
        .btn-auth:hover { opacity: 0.9; transform: translateY(-1px); color: #fff; }
        .text-danger { font-size: 0.82rem; }
        .note-text {
            background: #fff8e1; border-radius: 10px; padding: 12px 14px;
            font-size: 0.85rem; color: #f57f17; margin-bottom: 22px;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <div style="text-align:center;margin-bottom:6px;">
                <span class="setup-badge">ACCOUNT SETUP REQUIRED</span>
            </div>
            <div class="icon-wrap"><i class="fas fa-key"></i></div>
            <h1>Set Up Your Login</h1>
            <p>Your account needs a password and email</p>
        </div>

        <div class="note-text">
            <i class="fas fa-exclamation-triangle mr-1"></i>
            Your account was created without login credentials. Please set them up now.
        </div>

        <form asp-action="SetupAuth" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.88rem;"></div>

            <div class="form-group">
                <label>Your Name</label>
                <div class="input-icon">
                    <i class="fas fa-user"></i>
                    <input asp-for="Name" class="form-control" placeholder="Your name" />
                </div>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Email <span style="color:#f5576c;">*</span></label>
                <div class="input-icon">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="your@email.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
                <small class="text-muted">Used for password recovery</small>
            </div>

            <div class="form-group">
                <label>Password</label>
                <div class="input-icon">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Password" class="form-control" placeholder="Min. 6 characters" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Confirm Password</label>
                <div class="input-icon">
                    <i class="fas fa-lock"></i>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-auth">
                <i class="fas fa-check mr-2"></i>Save &amp; Continue
            </button>
        </form>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
