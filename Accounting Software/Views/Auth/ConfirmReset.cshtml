@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Approve Password Reset – Accounting Software</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.6.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            padding: 30px 16px;
        }
        .auth-card {
            background: #fff;
            border-radius: 18px;
            padding: 44px 40px 36px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.35);
            text-align: center;
        }
        .icon-wrap {
            width: 72px; height: 72px; border-radius: 18px;
            background: linear-gradient(135deg, #f093fb, #f5576c);
            display: inline-flex; align-items: center; justify-content: center;
            margin-bottom: 20px;
        }
        .icon-wrap i { font-size: 2rem; color: #fff; }
        h1 { font-size: 1.5rem; font-weight: 700; color: #1a1a2e; margin-bottom: 8px; }
        .sub { color: #6c757d; font-size: 0.95rem; margin-bottom: 24px; }
        .warning-box {
            background: #fff8e1;
            border-radius: 10px;
            padding: 14px 18px;
            margin-bottom: 24px;
            color: #e65100;
            font-size: 0.88rem;
            text-align: left;
        }
        .btn-approve {
            background: linear-gradient(135deg, #43e97b, #38f9d7);
            color: #1a1a2e;
            border: none;
            border-radius: 12px;
            padding: 14px 32px;
            font-size: 1rem;
            font-weight: 700;
            width: 100%;
            transition: opacity 0.2s, transform 0.15s;
            margin-bottom: 12px;
        }
        .btn-approve:hover { opacity: 0.9; transform: translateY(-1px); color: #1a1a2e; }
        .btn-cancel {
            background: transparent;
            color: #6c757d;
            border: 1.5px solid #dee2e6;
            border-radius: 12px;
            padding: 12px 32px;
            font-size: 0.95rem;
            font-weight: 500;
            width: 100%;
            text-decoration: none;
            display: block;
            transition: background 0.15s;
        }
        .btn-cancel:hover { background: #f8f9fa; color: #1a1a2e; text-decoration: none; }
        .invalid-box {
            background: #fce4ec;
            border-radius: 12px;
            padding: 24px;
            color: #c62828;
        }
        .invalid-box i { font-size: 2.5rem; margin-bottom: 12px; display: block; }
    </style>
</head>
<body>
    <div class="auth-card">
        @if (ViewBag.Invalid == true)
        {
            <div class="invalid-box">
                <i class="fas fa-times-circle"></i>
                <h5 style="font-weight:700;">Link Expired or Invalid</h5>
                <p style="font-size:0.9rem;margin:0;">This reset link is no longer valid. Please request a new one.</p>
            </div>
            <a asp-action="ForgotPassword" class="btn-cancel mt-3">
                <i class="fas fa-redo mr-1"></i>Request new link
            </a>
        }
        else
        {
            <div class="icon-wrap"><i class="fas fa-shield-alt"></i></div>
            <h1>Approve Password Reset</h1>
            <p class="sub">You received this link because a password reset was requested for your account.</p>

            <div class="warning-box">
                <i class="fas fa-exclamation-triangle mr-1"></i>
                <strong>Did not request this?</strong> Click "Cancel" and your password stays unchanged. The link expires in 1 hour.
            </div>

            <a asp-action="ResetPassword" asp-route-token="@ViewBag.Token" class="btn btn-approve">
                <i class="fas fa-check mr-2"></i>Yes, I approve – Set new password
            </a>
            <a asp-action="Login" class="btn-cancel">
                <i class="fas fa-times mr-1"></i>Cancel – I did not request this
            </a>
        }
    </div>
</body>
</html>
