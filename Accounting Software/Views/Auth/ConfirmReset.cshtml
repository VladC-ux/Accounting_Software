@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Approve Password Reset — StockFlow</title>
    <link rel="icon" type="image/svg+xml" href="/img/logo-mark.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root{
            --green:#2D6A4F; --green-dark:#1F4D37; --green-light:#52B788; --green-tint:#E8F0E5;
            --green-soft:#F1F6EE;
            --bg:#F7F4EC; --card:#FFFFFF;
            --text:#1A2B23; --muted:#6B7280;
            --border:#E5E7EB; --border-soft:#F1EFE8;
            --red:#D9534F; --red-soft:#FBE5E1;
            --orange:#E89A3C; --orange-soft:#FBE9CF;
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        body{
            background:var(--bg);min-height:100vh;display:flex;
            align-items:center;justify-content:center;
            font-family:'Manrope',system-ui,sans-serif;color:var(--text);
            padding:30px 16px;
            background-image:
                radial-gradient(circle at 15% 20%, rgba(45,106,79,0.10), transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(82,183,136,0.10), transparent 45%);
        }
        .auth-card{
            background:var(--card);border-radius:22px;padding:40px 36px 32px;
            width:100%;max-width:460px;text-align:center;
            box-shadow:0 22px 60px rgba(31,41,55,0.10),0 4px 14px rgba(31,41,55,0.04);
            border:1px solid var(--border-soft);
        }
        .icon-wrap{
            width:72px;height:72px;border-radius:20px;
            background:linear-gradient(135deg,var(--green),var(--green-light));
            display:inline-flex;align-items:center;justify-content:center;margin-bottom:20px;
            box-shadow:0 10px 22px rgba(45,106,79,0.30);
        }
        .icon-wrap i{font-size:2rem;color:#fff;}
        h1{font-size:1.5rem;font-weight:800;color:var(--text);letter-spacing:-.02em;margin-bottom:8px;}
        .sub{color:var(--muted);font-size:0.92rem;margin-bottom:22px;}

        .warning-box{
            background:var(--orange-soft);border:1px solid var(--orange);
            border-radius:12px;padding:14px 18px;margin-bottom:22px;
            color:#7A4A12;font-size:0.86rem;text-align:left;
            display:flex;gap:10px;align-items:flex-start;
        }
        .warning-box i{color:var(--orange);margin-top:2px;}

        .btn-approve{
            background:var(--green);color:#fff;border:none;border-radius:12px;
            padding:13px 28px;font-size:0.95rem;font-weight:700;width:100%;
            cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;
            box-shadow:0 6px 16px rgba(45,106,79,0.28);text-decoration:none;
            margin-bottom:10px;transition:all .15s;
        }
        .btn-approve:hover{background:var(--green-dark);color:#fff;transform:translateY(-1px);box-shadow:0 9px 22px rgba(45,106,79,0.35);text-decoration:none;}
        .btn-cancel{
            background:#fff;color:var(--muted);border:1.5px solid var(--border);
            border-radius:12px;padding:12px 28px;font-size:0.9rem;font-weight:600;
            width:100%;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:8px;
            transition:all .15s;
        }
        .btn-cancel:hover{background:var(--green-soft);color:var(--text);text-decoration:none;border-color:var(--green-tint);}

        .invalid-box{
            background:var(--red-soft);border:1px solid var(--red);
            border-radius:14px;padding:24px;color:var(--red);
        }
        .invalid-box i{font-size:2.4rem;margin-bottom:12px;display:block;}
        .invalid-box h5{font-weight:800;color:#7A2322;margin-bottom:6px;}
    </style>
</head>
<body>
    <div class="auth-card">
        @if (ViewBag.Invalid == true)
        {
            <div class="invalid-box">
                <i class="fas fa-times-circle"></i>
                <h5>Link Expired or Invalid</h5>
                <p style="font-size:0.88rem;margin:0;">This reset link is no longer valid. Please request a new one.</p>
            </div>
            <a asp-action="ForgotPassword" class="btn-cancel" style="margin-top:14px;">
                <i class="fas fa-redo"></i> Request new link
            </a>
        }
        else
        {
            <div class="icon-wrap"><i class="fas fa-shield-alt"></i></div>
            <h1>Approve Password Reset</h1>
            <p class="sub">You received this link because a password reset was requested for your account.</p>

            <div class="warning-box">
                <i class="fas fa-exclamation-triangle"></i>
                <div><strong>Did not request this?</strong> Click "Cancel" and your password stays unchanged. The link expires in 1 hour.</div>
            </div>

            <a asp-action="ResetPassword" asp-route-token="@ViewBag.Token" class="btn-approve">
                <i class="fas fa-check"></i> Yes, I approve – Set new password
            </a>
            <a asp-action="Login" class="btn-cancel">
                <i class="fas fa-times"></i> Cancel – I did not request this
            </a>
        }
    </div>
</body>
</html>
