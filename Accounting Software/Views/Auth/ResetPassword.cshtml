@model Accounting_Software.ViewModel.ResetPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["New Password"] — StockFlow</title>
    <link rel="icon" type="image/svg+xml" href="/img/logo-mark.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root{
            --green:#2D6A4F; --green-dark:#1F4D37; --green-light:#52B788; --green-tint:#E8F0E5;
            --green-soft:#F1F6EE;
            --bg:#F7F4EC; --card:#FFFFFF;
            --text:#1A2B23; --muted:#6B7280;
            --border:#E5E7EB; --border-soft:#F1EFE8;
            --red:#D9534F; --red-soft:#FBE5E1;
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        body{
            background:var(--bg);min-height:100vh;display:flex;
            align-items:center;justify-content:center;
            font-family:'Manrope',system-ui,sans-serif;color:var(--text);
            padding:30px 16px;
            background-image:
                radial-gradient(circle at 15% 20%, rgba(45,106,79,0.10), transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(82,183,136,0.10), transparent 45%);
        }
        .auth-card{
            background:var(--card);border-radius:22px;padding:40px 36px 32px;
            width:100%;max-width:420px;
            box-shadow:0 22px 60px rgba(31,41,55,0.10),0 4px 14px rgba(31,41,55,0.04);
            border:1px solid var(--border-soft);
        }
        .auth-logo{text-align:center;margin-bottom:24px;}
        .auth-logo .icon-wrap{
            width:64px;height:64px;border-radius:18px;
            background:linear-gradient(135deg,var(--green),var(--green-light));
            display:inline-flex;align-items:center;justify-content:center;margin-bottom:14px;
            box-shadow:0 8px 20px rgba(45,106,79,0.30);
        }
        .auth-logo .icon-wrap i{font-size:1.8rem;color:#fff;}
        .auth-logo h1{font-size:1.4rem;font-weight:800;color:var(--text);letter-spacing:-.02em;}
        .auth-logo p{color:var(--muted);font-size:0.88rem;margin:4px 0 0;}

        .form-group{margin-bottom:16px;}
        .form-group label{
            display:block;font-weight:600;font-size:0.78rem;
            color:var(--muted);margin-bottom:6px;
            text-transform:uppercase;letter-spacing:.04em;
        }
        .input-icon{position:relative;}
        .input-icon i{
            position:absolute;left:14px;top:50%;transform:translateY(-50%);
            color:var(--muted);font-size:0.9rem;
        }
        .form-control{
            width:100%;border-radius:12px;border:1.5px solid var(--border);
            padding:12px 14px 12px 40px;font-size:0.92rem;font-family:inherit;
            background:#fff;color:var(--text);transition:all .15s;
        }
        .form-control:focus{
            outline:none;border-color:var(--green);
            box-shadow:0 0 0 4px rgba(45,106,79,0.12);
        }

        .btn-auth{
            background:var(--green);color:#fff;border:none;border-radius:12px;
            padding:13px;font-size:0.95rem;font-weight:700;width:100%;
            cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;
            box-shadow:0 6px 16px rgba(45,106,79,0.28);
            transition:all .15s;
        }
        .btn-auth:hover{background:var(--green-dark);transform:translateY(-1px);box-shadow:0 9px 22px rgba(45,106,79,0.35);}

        .back-link{
            display:block;text-align:center;margin-top:18px;
            color:var(--green);font-size:0.85rem;font-weight:600;text-decoration:none;
        }
        .back-link:hover{text-decoration:underline;}
        .text-danger{color:var(--red);font-size:0.78rem;display:block;margin-top:4px;}

        .invalid-box{
            background:var(--red-soft);border:1px solid var(--red);
            border-radius:14px;padding:22px;text-align:center;color:var(--red);
        }
        .invalid-box i{font-size:2.4rem;margin-bottom:12px;display:block;}
        .invalid-box h5{font-weight:800;margin-bottom:6px;color:#7A2322;}
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <div class="icon-wrap"><i class="fas fa-shield-alt"></i></div>
            <h1>@Localizer["New Password"]</h1>
            <p>@Localizer["Enter your new password below"]</p>
        </div>

        @if (ViewBag.Invalid == true)
        {
            <div class="invalid-box">
                <i class="fas fa-times-circle"></i>
                <h5>@Localizer["Link Expired or Invalid"]</h5>
                <p style="font-size:0.88rem;margin:0;">@Localizer["This reset link is no longer valid. Please request a new one."]</p>
            </div>
            <a asp-action="ForgotPassword" class="back-link" style="margin-top:14px;">
                <i class="fas fa-redo"></i> @Localizer["Request new link"]
            </a>
        }
        else
        {
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:12px;"></div>

                <div class="form-group">
                    <label>@Localizer["New Password"]</label>
                    <div class="input-icon">
                        <i class="fas fa-lock"></i>
                        <input asp-for="NewPassword" class="form-control" placeholder="@Localizer["Min. 6 characters"]" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>@Localizer["Confirm New Password"]</label>
                    <div class="input-icon">
                        <i class="fas fa-lock"></i>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="@Localizer["Repeat password"]" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-auth">
                    <i class="fas fa-check"></i> @Localizer["Set New Password"]
                </button>
            </form>
            <a asp-action="Login" class="back-link">
                <i class="fas fa-arrow-left"></i> @Localizer["Back to Login"]
            </a>
        }
    </div>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
