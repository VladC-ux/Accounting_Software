@model Accounting_Software.ViewModel.StatisticsViewModel
@using System.Globalization
@using System.Text.Json
@{
    Layout = "_FintegraLayout";
    var inv = CultureInfo.InvariantCulture;

    var monthLabels   = JsonSerializer.Serialize(Model.MonthLabels);
    var monthlySpent  = JsonSerializer.Serialize(Model.MonthlySpent);
    var monthlyEarned = JsonSerializer.Serialize(Model.MonthlyEarned);

    var topSoldLabels  = JsonSerializer.Serialize(Model.TopSoldProducts.Select(x => x.Label).ToList());
    var topSoldValues  = JsonSerializer.Serialize(Model.TopSoldProducts.Select(x => x.Value).ToList());

    var topBoughtLabels = JsonSerializer.Serialize(Model.TopBoughtProducts.Select(x => x.Label).ToList());
    var topBoughtValues = JsonSerializer.Serialize(Model.TopBoughtProducts.Select(x => x.Value).ToList());

    var storeLabels = JsonSerializer.Serialize(Model.RevenueByStore.Select(x => x.Label).ToList());
    var storeValues = JsonSerializer.Serialize(Model.RevenueByStore.Select(x => x.Value).ToList());

    string FmtMoney(decimal v) => v.ToString("N2", inv);

    ViewBag.ActivePage = "reports";
    ViewBag.PageTitle = "Reports";
    ViewBag.PageHeading = "Reports";
    ViewBag.PageSubtitle = "All-time overview based on transaction history";
}

@section Styles {
<style>
    .stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:22px;}
    .stat{
        background:var(--card);border-radius:var(--r-lg);padding:20px 22px;
        box-shadow:var(--shadow-sm);position:relative;overflow:hidden;
    }
    .stat-ico{
        width:42px;height:42px;border-radius:12px;display:grid;place-items:center;
        font-size:1rem;margin-bottom:14px;
    }
    .stat-ico.red{background:var(--red-soft);color:var(--red);}
    .stat-ico.green{background:var(--green-tint);color:var(--green);}
    .stat-ico.orange{background:var(--orange-soft);color:var(--orange);}
    .stat-ico.blue{background:var(--blue-soft);color:var(--blue);}
    .stat-lbl{font-size:.74rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:600;}
    .stat-val{font-size:1.55rem;font-weight:800;letter-spacing:-.02em;margin-top:6px;}
    .stat-val.c-red{color:var(--red);}
    .stat-val.c-green{color:var(--green);}
    .stat-val.c-orange{color:var(--orange);}
    .stat-sub{font-size:.74rem;color:var(--muted);margin-top:4px;}

    .chart-row{display:grid;grid-template-columns:1fr;gap:18px;margin-bottom:18px;}
    .chart-row.two{grid-template-columns:1fr 1fr;}

    .chart-host{height:300px;position:relative;}
    .chart-host.tall{height:340px;}
    .chart-empty{text-align:center;padding:48px 16px;color:var(--muted);}
    .chart-empty i{font-size:1.8rem;color:var(--border);margin-bottom:10px;display:block;}

    @@media(max-width:1100px){
        .stat-row{grid-template-columns:repeat(2,1fr);}
        .chart-row.two{grid-template-columns:1fr;}
    }
    @@media(max-width:600px){
        .stat-row{grid-template-columns:1fr;}
    }
</style>
}

<div class="stat-row">
    <div class="stat">
        <div class="stat-ico red"><i class="fas fa-arrow-down"></i></div>
        <div class="stat-lbl">Total Spent</div>
        <div class="stat-val c-red">@FmtMoney(Model.TotalSpent)</div>
        <div class="stat-sub">@Model.TotalPurchases purchases</div>
    </div>

    <div class="stat">
        <div class="stat-ico green"><i class="fas fa-arrow-up"></i></div>
        <div class="stat-lbl">Total Earned</div>
        <div class="stat-val c-green">@FmtMoney(Model.TotalEarned)</div>
        <div class="stat-sub">@Model.TotalSales sales</div>
    </div>

    <div class="stat">
        <div class="stat-ico orange"><i class="fas fa-chart-line"></i></div>
        <div class="stat-lbl">Net Profit</div>
        <div class="stat-val @(Model.NetProfit >= 0 ? "c-green" : "c-red")">@FmtMoney(Model.NetProfit)</div>
        <div class="stat-sub">Earned − Spent</div>
    </div>

    <div class="stat">
        <div class="stat-ico blue"><i class="fas fa-exchange-alt"></i></div>
        <div class="stat-lbl">Total Transactions</div>
        <div class="stat-val">@(Model.TotalPurchases + Model.TotalSales)</div>
        <div class="stat-sub">@Model.TotalPurchases in · @Model.TotalSales out</div>
    </div>
</div>

<div class="chart-row">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3>Income vs Expenses</h3>
                <div class="hd-sub">Monthly comparison — last 6 months</div>
            </div>
        </div>
        <div class="chart-host"><canvas id="monthlyChart"></canvas></div>
    </div>
</div>

<div class="chart-row two">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3>Top 5 by Sales</h3>
                <div class="hd-sub">Most profitable products</div>
            </div>
        </div>
        @if (Model.TopSoldProducts.Any())
        {
            <div class="chart-host"><canvas id="topSoldChart"></canvas></div>
        }
        else
        {
            <div class="chart-empty"><i class="fas fa-inbox"></i> No sales yet</div>
        }
    </div>

    <div class="card">
        <div class="card-hd">
            <div>
                <h3>Top 5 by Purchases</h3>
                <div class="hd-sub">Most bought products</div>
            </div>
        </div>
        @if (Model.TopBoughtProducts.Any())
        {
            <div class="chart-host"><canvas id="topBoughtChart"></canvas></div>
        }
        else
        {
            <div class="chart-empty"><i class="fas fa-inbox"></i> No purchases yet</div>
        }
    </div>
</div>

<div class="chart-row">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3>Revenue by Store</h3>
                <div class="hd-sub">Breakdown across retail points</div>
            </div>
        </div>
        @if (Model.RevenueByStore.Any())
        {
            <div class="chart-host tall"><canvas id="storeChart"></canvas></div>
        }
        else
        {
            <div class="chart-empty"><i class="fas fa-inbox"></i> No store sales yet</div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
    const COLORS = ['#2D6A4F','#52B788','#E89A3C','#4A90E2','#9F7AEA','#D9534F','#F4C77B','#6FB0EE','#B795F3','#3D8961'];

    const baseOpts = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'top', labels: { color: '#1A2B23', font: { family: 'Manrope', size: 12, weight: '600' } } },
            tooltip: { backgroundColor: '#1A2B23', padding: 12, cornerRadius: 10, titleFont: { family: 'Manrope' }, bodyFont: { family: 'Manrope' } }
        }
    };

    new Chart(document.getElementById('monthlyChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(monthLabels),
            datasets: [
                { label: 'Income',   data: @Html.Raw(monthlyEarned), backgroundColor: '#2D6A4F', borderRadius: 6, barPercentage: .65, categoryPercentage: .7 },
                { label: 'Expenses', data: @Html.Raw(monthlySpent),  backgroundColor: '#E89A3C', borderRadius: 6, barPercentage: .65, categoryPercentage: .7 }
            ]
        },
        options: {
            ...baseOpts,
            scales: {
                y: { beginAtZero: true, ticks: { color: '#6B7280', callback: v => '$' + v.toLocaleString() }, grid: { color: '#F1EFE8' } },
                x: { ticks: { color: '#6B7280' }, grid: { display: false } }
            }
        }
    });

    @if (Model.TopSoldProducts.Any())
    {
        <text>
        new Chart(document.getElementById('topSoldChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(topSoldLabels),
                datasets: [{ data: @Html.Raw(topSoldValues), backgroundColor: COLORS, borderWidth: 2, borderColor: '#fff' }]
            },
            options: { ...baseOpts, plugins: { ...baseOpts.plugins, legend: { position: 'right', labels: baseOpts.plugins.legend.labels } }, cutout: '62%' }
        });
        </text>
    }

    @if (Model.TopBoughtProducts.Any())
    {
        <text>
        new Chart(document.getElementById('topBoughtChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(topBoughtLabels),
                datasets: [{ data: @Html.Raw(topBoughtValues), backgroundColor: COLORS, borderWidth: 2, borderColor: '#fff' }]
            },
            options: { ...baseOpts, plugins: { ...baseOpts.plugins, legend: { position: 'right', labels: baseOpts.plugins.legend.labels } }, cutout: '62%' }
        });
        </text>
    }

    @if (Model.RevenueByStore.Any())
    {
        <text>
        new Chart(document.getElementById('storeChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(storeLabels),
                datasets: [{ label: 'Revenue', data: @Html.Raw(storeValues), backgroundColor: COLORS, borderRadius: 6 }]
            },
            options: {
                ...baseOpts,
                indexAxis: 'y',
                plugins: { ...baseOpts.plugins, legend: { display: false } },
                scales: {
                    x: { beginAtZero: true, ticks: { color: '#6B7280', callback: v => '$' + v.toLocaleString() }, grid: { color: '#F1EFE8' } },
                    y: { ticks: { color: '#6B7280' }, grid: { display: false } }
                }
            }
        });
        </text>
    }
</script>
}
