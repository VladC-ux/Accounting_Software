@using Accounting_Software.ViewModel
@model SellerViewModel
@{
    Layout = "_FintegraLayout";
    ViewBag.ActivePage = "sellers";
    ViewBag.PageTitle = Localizer["Edit Seller"].Value;
    ViewBag.PageHeading = Localizer["Edit Seller"].Value;
    ViewBag.PageSubtitle = Localizer["Update the seller name"].Value;
}

@section Styles {
<style>
    .form-wrap{max-width:680px;}
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .seller-info{
        background:var(--green-soft);border:1px solid var(--green-tint);
        border-radius:14px;padding:14px 16px;margin-bottom:22px;
        display:flex;align-items:center;gap:14px;
    }
    .seller-avatar{
        width:46px;height:46px;border-radius:50%;flex-shrink:0;
        background:linear-gradient(135deg,var(--green),var(--green-light));color:#fff;
        display:grid;place-items:center;font-weight:800;font-size:1.1rem;
        box-shadow:0 4px 10px rgba(45,106,79,.25);
    }
    .seller-info .title{font-size:1rem;font-weight:700;color:var(--text);}
    .seller-info .sub{font-size:.76rem;color:var(--muted);margin-top:2px;}

    .fg{margin-bottom:18px;}
    .fg label{display:block;font-size:.74rem;font-weight:700;color:var(--muted);margin-bottom:7px;text-transform:uppercase;letter-spacing:.05em;}
    .fg input{width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:12px;font-size:.92rem;font-family:inherit;background:#fff;color:var(--text);transition:all .15s;}
    .fg input:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 4px rgba(45,106,79,.12);}
    .validation-error{color:var(--red);font-size:.78rem;margin-top:5px;display:block;}

    .actions{display:flex;gap:10px;margin-top:22px;padding-top:18px;border-top:1px solid var(--border-soft);}
</style>
}

<a class="back-link" asp-action="Index" asp-controller="Seller">
    <i class="fas fa-arrow-left"></i> @Localizer["Back to Sellers"]
</a>

<div class="form-wrap">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3><i class="fas fa-user-edit" style="color:var(--green);margin-right:6px;"></i> @Localizer["Edit details"]</h3>
                <div class="hd-sub">@Localizer["Change the seller's display name"]</div>
            </div>
        </div>

        <div class="seller-info">
            <div class="seller-avatar">@(Model.Name.Length > 0 ? Model.Name.Substring(0, 1).ToUpper() : "?")</div>
            <div>
                <div class="title">@Model.Name</div>
                <div class="sub">@Localizer["Seller ID:"] @Model.Id</div>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Id" />

            <div class="fg">
                <label>@Localizer["Seller Name"]</label>
                <input asp-for="Name" placeholder="@Localizer["Enter new name..."]" required />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> @Localizer["Save Changes"]
                </button>
                <a asp-action="Index" asp-controller="Seller" class="btn btn-ghost">
                    <i class="fas fa-times"></i> @Localizer["Cancel"]
                </a>
            </div>
        </form>
    </div>
</div>
