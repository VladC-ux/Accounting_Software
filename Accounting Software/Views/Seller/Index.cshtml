@using Accounting_Software.ViewModel
@model List<SellerViewModel>
@{
    Layout = "_FintegraLayout";
    var sellers = (ViewBag.Sellers as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    var sellerCount = sellers.Count();

    ViewBag.ActivePage = "sellers";
    ViewBag.PageTitle = "Sellers";
    ViewBag.PageHeading = "Sellers";
    ViewBag.PageSubtitle = sellerCount + " supplier" + (sellerCount == 1 ? "" : "s") + " · Manage your network";
    ViewBag.HeaderActions =
        "<div class='search-pill'>"
        + "<i class='fas fa-search'></i>"
        + "<input type='text' id='sellerSearch' placeholder='Search sellers...' />"
        + "</div>"
        + "<a class='btn btn-ghost' href='/Export/Products'><i class='fas fa-file-excel'></i> Export</a>"
        + "<a class='btn btn-primary' href='/Seller/Add'><i class='fas fa-plus'></i> Add Seller</a>";
}

@section Styles {
<style>
    .search-pill{
        display:inline-flex;align-items:center;gap:8px;
        padding:9px 14px;background:var(--card);border:1px solid var(--border-soft);
        border-radius:12px;box-shadow:var(--shadow-xs);min-width:240px;
    }
    .search-pill i{color:var(--muted);font-size:.85rem;}
    .search-pill input{
        border:none;outline:none;background:transparent;flex:1;
        font-family:inherit;font-size:.85rem;color:var(--text);
    }
    .search-pill input::placeholder{color:var(--muted-soft);}

    .sellers-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:18px;}
    .seller-card{
        background:var(--card);border-radius:var(--r-lg);padding:0;
        box-shadow:var(--shadow-sm);overflow:hidden;
        transition:transform .18s, box-shadow .18s;
        display:flex;flex-direction:column;position:relative;
    }
    .seller-card::before{
        content:'';position:absolute;top:0;left:0;right:0;height:3px;
        background:linear-gradient(90deg,var(--green),var(--green-light),var(--orange));
        opacity:0;transition:opacity .18s;
    }
    .seller-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);}
    .seller-card:hover::before{opacity:1;}

    .seller-body{padding:20px;display:flex;flex-direction:column;flex:1;}
    .seller-row{display:flex;align-items:center;gap:14px;margin-bottom:14px;}
    .seller-avatar{
        width:48px;height:48px;border-radius:14px;display:grid;place-items:center;
        color:#fff;font-weight:700;font-size:1.1rem;flex-shrink:0;
        box-shadow:0 4px 10px rgba(45,106,79,.22);
    }
    .seller-name{
        font-size:1rem;font-weight:700;color:var(--text);letter-spacing:-.01em;
        display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
    }
    .seller-name:hover{color:var(--green);}
    .seller-meta{
        font-size:.74rem;color:var(--muted);margin-top:3px;
        display:flex;align-items:center;gap:6px;
    }
    .seller-meta .dot{width:6px;height:6px;background:var(--green-light);border-radius:50%;}

    .card-actions{
        display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:14px;
        border-top:1px dashed var(--border-soft);
    }
    .btn-view{background:var(--green-tint);color:var(--green);}
    .btn-view:hover{background:var(--green-light);color:#fff;}
    .btn-add{background:var(--green);color:#fff;box-shadow:0 3px 8px rgba(45,106,79,.22);}
    .btn-add:hover{background:var(--green-dark);color:#fff;}
    .btn-edit{background:var(--orange-soft);color:var(--orange);}
    .btn-edit:hover{background:var(--orange);color:#fff;}
    .btn-del{background:var(--card);color:var(--red);border:1px solid var(--red-soft);}
    .btn-del:hover{background:var(--red-soft);}

    .av-0{background:linear-gradient(135deg,#2D6A4F,#52B788);}
    .av-1{background:linear-gradient(135deg,#E89A3C,#F4C77B);}
    .av-2{background:linear-gradient(135deg,#4A90E2,#6FB0EE);}
    .av-3{background:linear-gradient(135deg,#9F7AEA,#B795F3);}
    .av-4{background:linear-gradient(135deg,#D9534F,#EA7E7A);}
    .av-5{background:linear-gradient(135deg,#1F4D37,#3D8961);}
</style>
}

@if (sellerCount > 0)
{
    <div class="sellers-grid" id="sellersGrid">
        @{ var idx = 0; }
        @foreach (var item in sellers)
        {
            var avClass = "av-" + (idx % 6);
            idx++;
            <div class="seller-card" data-name="@item.Name.ToString().ToLower()">
                <div class="seller-body">
                    <div class="seller-row">
                        <div class="seller-avatar @avClass">@item.Name.ToString().Substring(0, 1).ToUpper()</div>
                        <div style="min-width:0;flex:1;">
                            <a class="seller-name" href="@Url.Action("ShowSellerProduct", "Product", new { SellerId = item.Id })">@item.Name</a>
                            <div class="seller-meta"><span class="dot"></span> Active · ID #@item.Id</div>
                        </div>
                    </div>
                    <div class="card-actions">
                        <a class="btn-icon-sm btn-view" href="@Url.Action("ShowSellerProduct", "Product", new { SellerId = item.Id })">
                            <i class="fas fa-eye"></i> View
                        </a>
                        <a class="btn-icon-sm btn-add" asp-action="Add" asp-controller="Product" asp-route-SellerId="@item.Id">
                            <i class="fas fa-plus"></i> Product
                        </a>
                        <a class="btn-icon-sm btn-edit" asp-action="Edit" asp-controller="Seller" asp-route-id="@item.Id">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a class="btn-icon-sm btn-del" asp-action="Delete" asp-controller="Seller" asp-route-id="@item.Id"
                           onclick="return confirm('Delete seller @item.Name?')">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-ico"><i class="fas fa-user-slash"></i></div>
        <h4>No sellers yet</h4>
        <p>Add your first seller to start tracking products.</p>
        <a class="btn btn-primary" asp-action="Add" asp-controller="Seller"><i class="fas fa-plus"></i> Add Seller</a>
    </div>
}

@section Scripts {
<script>
    var input = document.getElementById('sellerSearch');
    if (input) {
        input.addEventListener('input', function () {
            var q = this.value.toLowerCase().trim();
            document.querySelectorAll('.seller-card').forEach(function (card) {
                var name = card.getAttribute('data-name') || '';
                card.style.display = name.indexOf(q) >= 0 ? '' : 'none';
            });
        });
    }
</script>
}
