@using Accounting_Software.ViewModel
@model SellerViewModel
@{
    Layout = "_FintegraLayout";
    ViewBag.ActivePage = "sellers";
    ViewBag.PageTitle = "New Seller";
    ViewBag.PageHeading = "New Seller";
    ViewBag.PageSubtitle = "Add a new partner to start tracking their products";
}

@section Styles {
<style>
    .form-wrap{max-width:680px;}
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .fg{margin-bottom:18px;}
    .fg label{display:block;font-size:.74rem;font-weight:700;color:var(--muted);margin-bottom:7px;text-transform:uppercase;letter-spacing:.05em;}
    .fg input{width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:12px;font-size:.92rem;font-family:inherit;background:#fff;color:var(--text);transition:all .15s;}
    .fg input:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 4px rgba(45,106,79,.12);}
    .hint{font-size:.76rem;color:var(--muted);margin-top:6px;display:flex;align-items:center;gap:6px;}
    .hint i{color:var(--green);}
    .validation-error{color:var(--red);font-size:.78rem;margin-top:5px;display:block;}

    .actions{display:flex;gap:10px;margin-top:22px;padding-top:18px;border-top:1px solid var(--border-soft);}
</style>
}

<a class="back-link" asp-action="Index" asp-controller="Seller">
    <i class="fas fa-arrow-left"></i> Back to Sellers
</a>

<div class="form-wrap">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3><i class="fas fa-user-plus" style="color:var(--green);margin-right:6px;"></i> Seller details</h3>
                <div class="hd-sub">This name will appear on products, receipts and reports</div>
            </div>
        </div>

        <form method="post">
            <div class="fg">
                <label>Seller Name</label>
                <input asp-for="Name" placeholder="e.g. Acme Distribution Ltd." required autofocus />
                <span asp-validation-for="Name" class="validation-error"></span>
                <div class="hint"><i class="fas fa-info-circle"></i> Used across the system to identify this partner.</div>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-check"></i> Save Seller
                </button>
                <a class="btn btn-ghost" asp-action="Index" asp-controller="Seller">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>
