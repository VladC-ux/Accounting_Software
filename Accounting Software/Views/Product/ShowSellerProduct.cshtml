@using Accounting_Software.ViewModel;
@model List<ProductViewModel>
@{
    Layout = "_FintegraLayout";
    var sellerId = Model != null && Model.Any() ? Model.First().SellerId : 0;
    var totalValue = Model != null ? Model.Sum(p => p.Total) : 0;
    var totalItems = Model != null ? Model.Sum(p => p.Count) : 0;
    var count = Model?.Count ?? 0;
    ViewBag.ActivePage = "sellers";
    ViewBag.PageTitle = "Products";
    ViewBag.PageHeading = "Products";
    ViewBag.PageSubtitle = $"{count} item{(count == 1 ? "" : "s")} for this seller";

    if (sellerId > 0)
    {
        ViewBag.HeaderActions = $@"<a class='btn btn-primary' href='/Product/Add?SellerId={sellerId}'><i class='fas fa-plus'></i> Add Product</a>"
                              + $@"<a class='btn btn-ghost' href='/Seller/Index'><i class='fas fa-arrow-left'></i> Sellers</a>";
    }
}

@section Styles {
<style>
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px;}
    .kpi{background:var(--card);border-radius:var(--r-lg);padding:18px 20px;box-shadow:var(--shadow-sm);display:flex;align-items:center;gap:14px;}
    .kpi .ic{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;font-size:1.1rem;flex-shrink:0;}
    .kpi .ic.g{background:var(--green-tint);color:var(--green);}
    .kpi .ic.o{background:var(--orange-soft);color:var(--orange);}
    .kpi .ic.b{background:#E1ECFB;color:#4A90E2;}
    .kpi .lbl{font-size:.74rem;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.04em;}
    .kpi .val{font-size:1.3rem;font-weight:800;color:var(--text);letter-spacing:-.02em;}
    @@media(max-width:780px){.kpi-row{grid-template-columns:1fr;}}

    .toolbar{
        background:var(--card);border-radius:var(--r);padding:12px 16px;
        box-shadow:var(--shadow-sm);margin-bottom:16px;
        display:flex;align-items:center;gap:10px;
    }
    .toolbar i{color:var(--muted);}
    .toolbar input{flex:1;border:none;outline:none;font-size:.92rem;font-family:inherit;background:transparent;color:var(--text);}
    .toolbar input::placeholder{color:var(--muted-soft);}

    .tbl-wrap{overflow-x:auto;}
    table.products-table{width:100%;border-collapse:collapse;font-size:.86rem;}
    .products-table th{
        background:var(--green-soft);color:var(--muted);font-weight:700;
        font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;
        padding:11px 14px;text-align:left;border-bottom:1px solid var(--border-soft);white-space:nowrap;
    }
    .products-table td{padding:14px;border-bottom:1px solid var(--border-soft);color:var(--text);vertical-align:middle;}
    .products-table tr:last-child td{border-bottom:none;}
    .products-table tbody tr:hover td{background:var(--green-soft);}
    .price-badge{background:var(--green-tint);color:var(--green);padding:3px 10px;border-radius:99px;font-weight:700;font-size:.78rem;white-space:nowrap;}
    .total-badge{background:var(--green);color:#fff;padding:3px 10px;border-radius:99px;font-weight:700;font-size:.78rem;white-space:nowrap;}
    .unit-pill{display:inline-flex;align-items:center;background:var(--orange-soft);color:var(--orange);padding:3px 10px;border-radius:99px;font-size:.74rem;font-weight:700;}

    .row-actions{display:flex;gap:6px;flex-wrap:nowrap;}
    .btn-icon-sm{padding:7px 10px;border-radius:10px;font-size:.76rem;font-weight:600;display:inline-flex;align-items:center;gap:5px;text-decoration:none;transition:all .15s;}
    .btn-edit{background:var(--orange-soft);color:var(--orange);border:1px solid var(--orange-soft);}
    .btn-edit:hover{background:var(--orange);color:#fff;text-decoration:none;}
    .btn-del{background:var(--red-soft);color:var(--red);border:1px solid var(--red-soft);}
    .btn-del:hover{background:var(--red);color:#fff;text-decoration:none;}
    .btn-shops{background:#E1ECFB;color:#4A90E2;border:1px solid #E1ECFB;}
    .btn-shops:hover{background:#4A90E2;color:#fff;text-decoration:none;}

    .empty{padding:48px;text-align:center;color:var(--muted);}
    .empty .ic{width:64px;height:64px;border-radius:50%;background:var(--green-soft);color:var(--green);display:grid;place-items:center;font-size:1.4rem;margin:0 auto 12px;}

    .table-foot{padding:14px 18px;border-top:1px solid var(--border-soft);display:flex;justify-content:flex-end;gap:24px;font-size:.86rem;color:var(--muted);font-weight:600;}
    .table-foot strong{color:var(--text);}
</style>
}

<a class="back-link" asp-controller="Seller" asp-action="Index">
    <i class="fas fa-arrow-left"></i> Back to Sellers
</a>

<div class="kpi-row">
    <div class="kpi"><div class="ic g"><i class="fas fa-cube"></i></div><div><div class="lbl">Products</div><div class="val">@count</div></div></div>
    <div class="kpi"><div class="ic o"><i class="fas fa-layer-group"></i></div><div><div class="lbl">Items in stock</div><div class="val">@totalItems</div></div></div>
    <div class="kpi"><div class="ic b"><i class="fas fa-dollar-sign"></i></div><div><div class="lbl">Total value</div><div class="val">@totalValue.ToString("N2")</div></div></div>
</div>

<div class="card">
    <div class="card-hd">
        <div>
            <h3><i class="fas fa-boxes" style="color:var(--green);margin-right:6px;"></i> Product list</h3>
            <div class="hd-sub">All products for this seller</div>
        </div>
    </div>

    <div class="toolbar">
        <i class="fas fa-search"></i>
        <input type="text" id="productSearch" placeholder="Search products..." />
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="tbl-wrap">
            <table class="products-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Description</th>
                        <th>Mass</th>
                        <th>Unit</th>
                        <th>Count</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td><span class="price-badge">@item.Price.ToString("N2")</span></td>
                            <td style="color:var(--muted);">@item.Description</td>
                            <td>@item.Mass</td>
                            <td><span class="unit-pill">@item.unitOfmass</span></td>
                            <td>@item.Count</td>
                            <td><span class="total-badge">@item.Total.ToString("N2")</span></td>
                            <td>
                                <div class="row-actions">
                                    <a class="btn-icon-sm btn-edit" asp-action="Edit" asp-controller="Product" asp-route-id="@item.Id">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a class="btn-icon-sm btn-del" asp-action="Delete" asp-controller="Product"
                                       asp-route-id="@item.Id" asp-route-SellerId="@item.SellerId"
                                       onclick="return confirm('Delete @item.Name?')">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                    <a class="btn-icon-sm btn-shops" asp-action="ShowShops" asp-controller="Store" asp-route-id="@item.Id">
                                        <i class="fas fa-warehouse"></i> Shops
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-foot">
            <div><i class="fas fa-layer-group" style="color:var(--orange);"></i> Total items: <strong>@totalItems</strong></div>
            <div><i class="fas fa-dollar-sign" style="color:var(--green);"></i> Total value: <strong>@totalValue.ToString("N2")</strong></div>
        </div>
    }
    else
    {
        <div class="empty">
            <div class="ic"><i class="fas fa-box-open"></i></div>
            <h4 style="font-weight:700;margin-bottom:6px;color:var(--text);">No products yet</h4>
            <p style="font-size:.86rem;">Add a product to get started.</p>
            @if (sellerId > 0)
            {
                <a class="btn btn-primary" asp-action="Add" asp-controller="Product" asp-route-SellerId="@sellerId" style="margin-top:14px;">
                    <i class="fas fa-plus"></i> Add Product
                </a>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    document.getElementById('productSearch').addEventListener('input', function () {
        const q = this.value.toLowerCase().trim();
        document.querySelectorAll('.products-table tbody tr').forEach(function (row) {
            const name = row.cells[0].textContent.toLowerCase();
            row.style.display = name.includes(q) ? '' : 'none';
        });
    });
</script>
}
