@using Accounting_Software.ViewModel;
@model ProductViewModel;
@{
    Layout = "_FintegraLayout";
    var products = ViewBag.Products as List<Accounting_Software.ViewModel.ProductViewModel>;
    var balance = (ViewBag.UserBalance as decimal? ?? 0m);
    ViewBag.ActivePage = "sellers";
    ViewBag.PageTitle = Localizer["New Product"].Value;
    ViewBag.PageHeading = Localizer["New Product"].Value;
    ViewBag.PageSubtitle = Localizer["Register a new purchase from this seller"].Value;
}

@section Styles {
<style>
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .balance-banner{
        background:linear-gradient(135deg,var(--green-soft),var(--green-tint));
        border:1px solid var(--green-tint);border-radius:var(--r-lg);
        padding:18px 22px;display:flex;align-items:center;justify-content:space-between;
        margin-bottom:20px;gap:14px;flex-wrap:wrap;
    }
    .balance-banner .l{display:flex;align-items:center;gap:14px;}
    .balance-banner .ic{
        width:48px;height:48px;border-radius:14px;flex-shrink:0;
        background:linear-gradient(135deg,var(--green),var(--green-light));color:#fff;
        display:grid;place-items:center;font-size:1.2rem;
        box-shadow:0 6px 14px rgba(45,106,79,.28);
    }
    .balance-banner .lbl{font-size:.72rem;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.05em;}
    .balance-banner .val{font-size:1.25rem;font-weight:800;color:var(--text);letter-spacing:-.01em;}

    .alert-box{
        padding:12px 16px;border-radius:12px;margin-bottom:16px;font-size:.86rem;font-weight:500;
        display:flex;align-items:center;gap:10px;
    }
    .alert-ok{background:var(--green-soft);color:var(--green-dark);border:1px solid var(--green-tint);}
    .alert-err{background:var(--red-soft);color:#7A2322;border:1px solid #F1B3B0;}

    .section-head{
        display:flex;align-items:center;gap:9px;font-size:.74rem;font-weight:700;
        text-transform:uppercase;letter-spacing:.06em;color:var(--muted);
        margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border-soft);
    }
    .section-head .dot{width:6px;height:6px;border-radius:50%;background:var(--green);}

    .fg{margin-bottom:16px;}
    .fg label{display:block;font-size:.74rem;font-weight:700;color:var(--muted);margin-bottom:7px;text-transform:uppercase;letter-spacing:.05em;}
    .fg input, .fg select, .fg textarea{
        width:100%;padding:11px 13px;border:1.5px solid var(--border);
        border-radius:12px;font-size:.92rem;font-family:inherit;
        background:#fff;color:var(--text);transition:all .15s;
    }
    .fg input:focus, .fg select:focus, .fg textarea:focus{
        outline:none;border-color:var(--green);box-shadow:0 0 0 4px rgba(45,106,79,.12);
    }

    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    .grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;}
    @@media(max-width:640px){.grid-2,.grid-3{grid-template-columns:1fr;}}

    .type-toggle{
        display:grid;grid-template-columns:1fr 1fr;gap:6px;
        background:var(--green-soft);border-radius:12px;padding:5px;border:1px solid var(--green-tint);
    }
    .type-toggle input[type="radio"]{display:none;}
    .type-toggle label{
        text-align:center;padding:9px 12px;border-radius:9px;
        font-size:.84rem;font-weight:600;color:var(--muted);cursor:pointer;
        transition:all .18s;display:inline-flex;align-items:center;justify-content:center;gap:7px;margin:0;
    }
    .type-toggle input[type="radio"]:checked + label{
        background:#fff;color:var(--green);box-shadow:0 4px 10px rgba(45,106,79,.15);
    }

    .summary{
        background:linear-gradient(135deg,var(--green),var(--green-dark));
        border-radius:14px;padding:18px 22px;
        display:flex;align-items:center;justify-content:space-between;
        margin:14px 0 20px;position:relative;overflow:hidden;color:#fff;
    }
    .summary::before{
        content:'';position:absolute;top:-30px;right:-30px;width:140px;height:140px;
        background:radial-gradient(circle,rgba(255,255,255,.12),transparent 70%);border-radius:50%;
    }
    .summary .col{position:relative;z-index:1;}
    .summary .label{font-size:.7rem;color:rgba(255,255,255,.7);font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;}
    .summary .amount{font-size:1.7rem;font-weight:800;letter-spacing:-.02em;}
    .summary .balance-left{font-size:.78rem;color:rgba(255,255,255,.7);margin-top:4px;}
    .summary .warning{color:#FFCFCB;font-weight:700;}
    .summary .calc-icon{
        width:48px;height:48px;border-radius:12px;
        background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);
        display:grid;place-items:center;font-size:1.3rem;position:relative;z-index:1;
    }

    .actions{display:flex;gap:10px;padding-top:6px;}

    .list-card{margin-top:22px;}
    .list-head .count{
        margin-left:auto;background:var(--green-tint);color:var(--green);
        padding:4px 12px;border-radius:99px;font-size:.74rem;font-weight:700;
    }

    .tbl-wrap{overflow-x:auto;}
    table.products-table{width:100%;border-collapse:collapse;font-size:.86rem;}
    .products-table th{
        background:var(--green-soft);color:var(--muted);font-weight:700;
        font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;
        padding:11px 14px;text-align:left;border-bottom:1px solid var(--border-soft);white-space:nowrap;
    }
    .products-table td{padding:14px;border-bottom:1px solid var(--border-soft);color:var(--text);vertical-align:middle;}
    .products-table tr:last-child td{border-bottom:none;}
    .products-table tbody tr:hover td{background:var(--green-soft);}
    .price-cell{font-weight:700;color:var(--green);}
    .unit-pill{display:inline-flex;align-items:center;background:var(--green-tint);color:var(--green);padding:3px 10px;border-radius:99px;font-size:.74rem;font-weight:700;}
    .total-pill{display:inline-flex;align-items:center;background:var(--green);color:#fff;padding:3px 10px;border-radius:99px;font-size:.74rem;font-weight:700;}

    .empty{padding:48px;text-align:center;color:var(--muted);}
    .empty .ic{
        width:60px;height:60px;border-radius:50%;background:var(--green-soft);
        color:var(--green);display:grid;place-items:center;font-size:1.4rem;margin:0 auto 12px;
    }
</style>
}

<a class="back-link" asp-action="Index" asp-controller="Seller">
    <i class="fas fa-arrow-left"></i> @Localizer["Back to Sellers"]
</a>

<div class="balance-banner">
    <div class="l">
        <div class="ic"><i class="fas fa-box-open"></i></div>
        <div>
            <div style="font-size:1.05rem;font-weight:800;color:var(--text);">@Localizer["New Product"]</div>
            <div style="font-size:.84rem;color:var(--muted);">@Localizer["Register a new purchase from this seller"]</div>
        </div>
    </div>
    <div style="display:flex;align-items:center;gap:12px;">
        <div class="ic" style="background:linear-gradient(135deg,#52B788,#74C69D);">
            <i class="fas fa-wallet"></i>
        </div>
        <div>
            <div class="lbl">@Localizer["Current Balance"]</div>
            <div class="val" id="balanceDisplay">@balance.ToString("N2")</div>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-box alert-err"><i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-box alert-ok"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
}

<div class="card">
    <form method="post" id="productForm">
        <input type="hidden" name="SellerId" value="@ViewBag.SellerId" />

        <div class="section-head"><span class="dot"></span> @Localizer["Product Details"]</div>

        <div class="grid-2">
            <div class="fg">
                <label>@Localizer["Product Name"]</label>
                <input asp-for="Name" placeholder="@Localizer["e.g. Apple"]" required />
            </div>
            <div class="fg">
                <label>@Localizer["Price per unit"]</label>
                <input type="number" name="Price" id="priceInput" placeholder="0.00" step="0.01" min="0.01" required />
            </div>
        </div>

        <div class="fg">
            <label>@Localizer["Purchase Type"]</label>
            <div class="type-toggle">
                <input type="radio" id="typePiece" name="purchaseType" value="piece" checked />
                <label for="typePiece"><i class="fas fa-cubes"></i> @Localizer["By piece"]</label>
                <input type="radio" id="typeWeight" name="purchaseType" value="weight" />
                <label for="typeWeight"><i class="fas fa-weight-hanging"></i> @Localizer["By weight"]</label>
            </div>
        </div>

        <div class="grid-3" id="quantityGrid">
            <div class="fg">
                <label>@Localizer["Count (pcs)"]</label>
                <input type="number" name="Count" id="countInput" placeholder="0" min="1" required />
            </div>
            <div class="fg weight-only">
                <label>@Localizer["Mass"]</label>
                <input type="number" name="Mass" id="massInput" placeholder="0" min="1" />
            </div>
            <div class="fg weight-only">
                <label>@Localizer["Unit"]</label>
                <select name="unitOfmass" id="unitInput">
                    <option value="Kg">Kg</option>
                    <option value="Gram">Gram</option>
                    <option value="Ml">Ml</option>
                </select>
            </div>
        </div>

        <div class="fg">
            <label>@Localizer["Description (optional)"]</label>
            <input asp-for="Description" placeholder="@Localizer["Short description..."]" />
        </div>

        <div class="summary">
            <div class="col">
                <div class="label">@Localizer["Total Cost"]</div>
                <div class="amount" id="totalDisplay">0.00</div>
                <div class="balance-left" id="balanceAfter">@Localizer["Balance after:"] <span id="balanceAfterVal">—</span></div>
            </div>
            <div class="calc-icon"><i class="fas fa-calculator"></i></div>
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-check"></i> @Localizer["Save Product"]
            </button>
            <a asp-action="ShowSellerProduct" asp-controller="Product" asp-route-SellerId="@ViewBag.SellerId" class="btn btn-ghost">
                <i class="fas fa-list"></i> @Localizer["View Products"]
            </a>
        </div>
    </form>
</div>

<div class="card list-card">
    <div class="card-hd">
        <div>
            <h3><i class="fas fa-list" style="color:var(--green);margin-right:6px;"></i> @Localizer["Products of this Seller"]</h3>
            <div class="hd-sub">@Localizer["Existing items registered for this partner"]</div>
        </div>
        @if (products != null) { <div class="count">@products.Count @Localizer["items"]</div> }
    </div>

    @if (products != null && products.Any())
    {
        <div class="tbl-wrap">
            <table class="products-table">
                <thead>
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Price"]</th>
                        <th>@Localizer["Count"]</th>
                        <th>@Localizer["Mass"]</th>
                        <th>@Localizer["Unit"]</th>
                        <th>@Localizer["Total"]</th>
                        <th>@Localizer["Description"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in products)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td class="price-cell">@item.Price.ToString("N2")</td>
                            <td>@item.Count</td>
                            <td>@item.Mass</td>
                            <td><span class="unit-pill">@item.unitOfmass</span></td>
                            <td><span class="total-pill">@item.Total.ToString("N2")</span></td>
                            <td style="color:var(--muted);">@item.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty">
            <div class="ic"><i class="fas fa-box"></i></div>
            @Localizer["No products yet for this seller"]
        </div>
    }
</div>

@section Scripts {
<script>
    const balance = @balance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    const priceInput = document.getElementById('priceInput');
    const countInput = document.getElementById('countInput');
    const massInput = document.getElementById('massInput');
    const totalDisplay = document.getElementById('totalDisplay');
    const balanceAfterVal = document.getElementById('balanceAfterVal');
    const balanceAfter = document.getElementById('balanceAfter');
    const typePiece = document.getElementById('typePiece');
    const typeWeight = document.getElementById('typeWeight');
    const weightFields = document.querySelectorAll('.weight-only');
    const productForm = document.getElementById('productForm');

    function fmt(n){return n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});}

    function updateTotal() {
        const price = parseFloat(priceInput.value) || 0;
        const count = parseInt(countInput.value) || 0;
        const mass = parseInt(massInput.value) || 0;
        const isWeight = typeWeight.checked;
        const total = isWeight && mass > 0 ? price * count * mass : price * count;
        const remaining = balance - total;

        totalDisplay.textContent = fmt(total);
        balanceAfterVal.textContent = fmt(remaining);

        if (remaining < 0) {
            balanceAfter.classList.add('warning');
            totalDisplay.style.color = '#FFCFCB';
        } else {
            balanceAfter.classList.remove('warning');
            totalDisplay.style.color = '#fff';
        }
    }

    function applyPurchaseType() {
        const isWeight = typeWeight.checked;
        weightFields.forEach(el => { el.style.display = isWeight ? '' : 'none'; });
        massInput.required = isWeight;
    }

    priceInput.addEventListener('input', updateTotal);
    countInput.addEventListener('input', updateTotal);
    massInput.addEventListener('input', updateTotal);
    typePiece.addEventListener('change', () => { applyPurchaseType(); updateTotal(); });
    typeWeight.addEventListener('change', () => { applyPurchaseType(); updateTotal(); });

    productForm.addEventListener('submit', function () {
        if (!typeWeight.checked) {
            if (!massInput.value) massInput.value = 0;
        }
    });

    applyPurchaseType();
    updateTotal();
</script>
}
