@using Accounting_Software.ViewModel
@model ProductViewModel
@{
    Layout = "_FintegraLayout";
    ViewBag.ActivePage = "sellers";
    ViewBag.PageTitle = Localizer["Edit Product"].Value;
    ViewBag.PageHeading = Localizer["Edit Product"].Value;
    ViewBag.PageSubtitle = Localizer["Update product details"].Value;
}

@section Styles {
<style>
    .form-wrap{max-width:760px;}
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .product-info{
        background:var(--green-soft);border:1px solid var(--green-tint);
        border-radius:14px;padding:14px 16px;margin-bottom:22px;
        display:flex;align-items:center;gap:14px;
    }
    .product-info .ic{
        width:44px;height:44px;border-radius:12px;flex-shrink:0;
        background:linear-gradient(135deg,var(--green),var(--green-light));color:#fff;
        display:grid;place-items:center;font-size:1rem;
        box-shadow:0 4px 10px rgba(45,106,79,.22);
    }
    .product-info .title{font-weight:800;font-size:1rem;color:var(--text);}
    .product-info .sub{font-size:.76rem;color:var(--muted);margin-top:2px;}

    .fg{margin-bottom:16px;}
    .fg label{display:block;font-size:.74rem;font-weight:700;color:var(--muted);margin-bottom:7px;text-transform:uppercase;letter-spacing:.05em;}
    .fg input, .fg select, .fg textarea{
        width:100%;padding:11px 13px;border:1.5px solid var(--border);
        border-radius:12px;font-size:.92rem;font-family:inherit;
        background:#fff;color:var(--text);transition:all .15s;
    }
    .fg input:focus, .fg select:focus, .fg textarea:focus{
        outline:none;border-color:var(--green);box-shadow:0 0 0 4px rgba(45,106,79,.12);
    }
    .fg textarea{resize:vertical;min-height:84px;}

    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    @@media(max-width:640px){.grid-2{grid-template-columns:1fr;}}

    .actions{display:flex;gap:10px;margin-top:22px;padding-top:18px;border-top:1px solid var(--border-soft);}
</style>
}

<a class="back-link" asp-action="ShowSellerProduct" asp-controller="Product" asp-route-SellerId="@Model.SellerId">
    <i class="fas fa-arrow-left"></i> @Localizer["Back to Products"]
</a>

<div class="form-wrap">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3><i class="fas fa-pencil-alt" style="color:var(--green);margin-right:6px;"></i> @Localizer["Edit product"]</h3>
                <div class="hd-sub">@Localizer["Change the values below and save"]</div>
            </div>
        </div>

        <div class="product-info">
            <div class="ic"><i class="fas fa-box"></i></div>
            <div>
                <div class="title">@Model.Name</div>
                <div class="sub">@Localizer["ID:"] @Model.Id &nbsp;·&nbsp; @Localizer["Seller ID:"] @Model.SellerId</div>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SellerId" />

            <div class="grid-2">
                <div class="fg">
                    <label>@Localizer["Product Name"]</label>
                    <input asp-for="Name" required />
                </div>
                <div class="fg">
                    <label>@Localizer["Price"]</label>
                    <input asp-for="Price" min="1" required />
                </div>
            </div>

            <div class="grid-2">
                <div class="fg">
                    <label>@Localizer["Mass"]</label>
                    <input asp-for="Mass" min="1" required />
                </div>
                <div class="fg">
                    <label>@Localizer["Unit of Mass"]</label>
                    <select asp-for="unitOfmass" required>
                        <option value="Kg">Kg</option>
                        <option value="Gram">Gram</option>
                        <option value="Ml">Ml</option>
                    </select>
                </div>
            </div>

            <div class="fg">
                <label>@Localizer["Description"]</label>
                <textarea asp-for="Description" rows="3" placeholder="@Localizer["Description..."]"></textarea>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> @Localizer["Save Changes"]
                </button>
                <a asp-action="ShowSellerProduct" asp-controller="Product"
                   asp-route-SellerId="@Model.SellerId" class="btn btn-ghost">
                    <i class="fas fa-times"></i> @Localizer["Cancel"]
                </a>
            </div>
        </form>
    </div>
</div>
