@model Accounting_Software.ViewModel.TelegramSettingsViewModel
@{
    Layout = "_FintegraLayout";
    var botLink = !string.IsNullOrEmpty(Model.BotUsername)
        ? $"https://t.me/{Model.BotUsername.TrimStart('@')}"
        : null;
    ViewBag.ActivePage = "telegram";
    ViewBag.PageTitle = "Telegram";
    ViewBag.PageHeading = "Telegram Bot";
    ViewBag.PageSubtitle = "Get real-time notifications and reports";
}

@section Styles {
<style>
    .tg-wrap{max-width:880px;}
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .alert-box{
        padding:12px 16px;border-radius:12px;margin-bottom:16px;font-size:.86rem;font-weight:500;
        display:flex;align-items:center;gap:10px;
    }
    .alert-ok{background:var(--green-soft);color:var(--green-dark);border:1px solid var(--green-tint);}
    .alert-err{background:var(--red-soft);color:#7A2322;border:1px solid #F1B3B0;}
    .alert-warn{background:var(--orange-soft);color:#7A4A12;border:1px solid var(--orange);}

    .tg-card{margin-bottom:18px;}

    .status-row{display:flex;align-items:center;gap:14px;margin-bottom:18px;}
    .status-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;}
    .status-dot.ok{background:var(--green);box-shadow:0 0 0 4px rgba(45,106,79,.15);}
    .status-dot.off{background:var(--muted-soft);}
    .status-lbl{font-size:.94rem;font-weight:800;}
    .status-lbl.ok{color:var(--green-dark);}
    .status-lbl.off{color:var(--muted);}

    .how-box{
        background:var(--green-soft);border:1px solid var(--green-tint);
        border-radius:14px;padding:16px 18px;margin-bottom:14px;
    }
    .how-box h4{font-size:.88rem;margin:0 0 10px;color:var(--green-dark);font-weight:800;}
    .steps{counter-reset:s;list-style:none;padding:0;margin:0;}
    .steps li{counter-increment:s;display:flex;gap:12px;padding:8px 0;font-size:.88rem;color:var(--text);align-items:flex-start;}
    .steps li::before{
        content:counter(s);background:var(--green);color:#fff;width:22px;height:22px;
        border-radius:50%;display:flex;align-items:center;justify-content:center;
        font-weight:800;font-size:.74rem;flex-shrink:0;
    }
    code{background:var(--card);color:var(--green);padding:2px 8px;border-radius:6px;font-size:.84rem;font-weight:600;}

    .code-box{
        background:var(--green-soft);border:2px dashed var(--green-tint);
        border-radius:14px;padding:18px;text-align:center;margin:14px 0;
    }
    .code-val{font-family:'Courier New',monospace;font-size:1.6rem;font-weight:800;color:var(--green);letter-spacing:3px;}
    .code-hint{font-size:.78rem;color:var(--muted);margin-top:6px;}

    .btn-tg{background:#0088cc;color:#fff;box-shadow:0 4px 10px rgba(0,136,204,.25);}
    .btn-tg:hover{background:#006699;color:#fff;}

    .toggle-row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border-soft);}
    .toggle-row:last-child{border-bottom:none;}
    .toggle-info{flex:1;}
    .toggle-info h4{font-size:.92rem;font-weight:700;color:var(--text);margin:0;}
    .toggle-info p{font-size:.78rem;color:var(--muted);margin:2px 0 0;}
    .switch{position:relative;width:44px;height:24px;flex-shrink:0;}
    .switch input{opacity:0;width:0;height:0;}
    .slider{position:absolute;cursor:pointer;inset:0;background:var(--border);border-radius:24px;transition:.2s;}
    .slider::before{content:"";position:absolute;height:18px;width:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
    .switch input:checked + .slider{background:var(--green);}
    .switch input:checked + .slider::before{transform:translateX(20px);}

    .action-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;}

    .cmd-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:.86rem;color:var(--text);}
    @@media(max-width:560px){.cmd-grid{grid-template-columns:1fr;}}
</style>
}

<a class="back-link" asp-controller="Dashboard" asp-action="Index">
    <i class="fas fa-arrow-left"></i> Back to Dashboard
</a>

<div class="tg-wrap">
    @if (TempData["Success"] != null)
    {
        <div class="alert-box alert-ok"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-box alert-err"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
    }
    @if (!Model.BotConfigured)
    {
        <div class="alert-box alert-warn">
            <i class="fas fa-exclamation-triangle"></i>
            <span>Bot is not configured. Set <code>Telegram:BotToken</code> in <code>appsettings.json</code> and restart the application.</span>
        </div>
    }

    <div class="card tg-card">
        <div class="card-hd">
            <div>
                <h3><i class="fab fa-telegram" style="color:#0088cc;margin-right:6px;"></i> Connection Status</h3>
                <div class="hd-sub">Link your Telegram account to the system</div>
            </div>
            @if (botLink != null)
            {
                <a class="btn btn-tg" href="@botLink" target="_blank" rel="noopener">
                    <i class="fab fa-telegram"></i> Open Bot
                </a>
            }
        </div>

        <div class="status-row">
            <div class="status-dot @(Model.IsLinked ? "ok" : "off")"></div>
            <div>
                <div class="status-lbl @(Model.IsLinked ? "ok" : "off")">
                    @(Model.IsLinked ? "Account linked" : "Not linked")
                </div>
                @if (Model.IsLinked && !string.IsNullOrEmpty(Model.TelegramUsername))
                {
                    <div style="font-size:.78rem;color:var(--muted);margin-top:2px;">@@@Model.TelegramUsername</div>
                }
            </div>
        </div>

        @if (!Model.IsLinked)
        {
            <div class="how-box">
                <h4>How to link:</h4>
                <ol class="steps">
                    <li>Open the bot in Telegram@(botLink != null ? "" : " (set bot's @username in appsettings)")</li>
                    <li>Send <code>/start</code></li>
                    <li>Generate a code below and send it to the bot: <code>/link CODE</code></li>
                </ol>
            </div>

            @if (!string.IsNullOrEmpty(Model.LinkCode))
            {
                <div class="code-box">
                    <div class="code-val">@Model.LinkCode</div>
                    <div class="code-hint">Send to the bot: <code>/link @Model.LinkCode</code></div>
                </div>
            }

            <form asp-action="GenerateCode" method="post" style="display:inline;">
                <button class="btn btn-primary" type="submit">
                    <i class="fas fa-key"></i>
                    @(string.IsNullOrEmpty(Model.LinkCode) ? "Generate code" : "Generate new code")
                </button>
            </form>
        }
        else
        {
            <div class="action-row">
                <form asp-action="SendTest" method="post" style="display:inline;">
                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-paper-plane"></i> Send test
                    </button>
                </form>
                <form asp-action="Unlink" method="post" style="display:inline;"
                      onsubmit="return confirm('Unlink account from Telegram?');">
                    <button class="btn btn-danger" type="submit">
                        <i class="fas fa-unlink"></i> Unlink
                    </button>
                </form>
            </div>
        }
    </div>

    @if (Model.IsLinked)
    {
        <div class="card tg-card">
            <div class="card-hd">
                <div>
                    <h3><i class="fas fa-bell" style="color:var(--green);margin-right:6px;"></i> Notifications</h3>
                    <div class="hd-sub">Choose what the bot should send to you</div>
                </div>
            </div>

            <form asp-action="SavePreferences" method="post">
                <div class="toggle-row">
                    <div class="toggle-info">
                        <h4>New sales</h4>
                        <p>Instantly after a sale is recorded</p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="notifySales" value="true" @(Model.NotifySales ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="toggle-row">
                    <div class="toggle-info">
                        <h4>Low stock</h4>
                        <p>When a product is running low in a store</p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="notifyLowStock" value="true" @(Model.NotifyLowStock ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="toggle-row">
                    <div class="toggle-info">
                        <h4>Daily report</h4>
                        <p>End-of-day summary every evening</p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="dailyReport" value="true" @(Model.DailyReport ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div style="margin-top:18px;">
                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-save"></i> Save
                    </button>
                </div>
            </form>
        </div>

        <div class="card tg-card">
            <div class="card-hd">
                <div>
                    <h3><i class="fas fa-terminal" style="color:var(--green);margin-right:6px;"></i> Bot commands</h3>
                    <div class="hd-sub">Available commands inside the chat</div>
                </div>
            </div>
            <div class="cmd-grid">
                <div><code>/today</code> — today's report</div>
                <div><code>/week</code> — last 7 days</div>
                <div><code>/top</code> — top 5 products</div>
                <div><code>/low</code> — low stock</div>
                <div><code>/help</code> — all commands</div>
                <div><code>/unlink</code> — unlink account</div>
            </div>
        </div>
    }
</div>
