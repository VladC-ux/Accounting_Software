@model Accounting_Software.ViewModel.StoreProductViewModel
@{
    Layout = "_FintegraLayout";
    ViewBag.ActivePage = "stores";
    ViewBag.PageTitle = "Add Product to Store";
    ViewBag.PageHeading = "Add Product to Store";
    ViewBag.PageSubtitle = "Move a product from inventory into a store";
}

@section Styles {
<style>
    .form-wrap{max-width:760px;}
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .alert-box{
        padding:12px 16px;border-radius:12px;margin-bottom:16px;font-size:.86rem;font-weight:500;
        display:flex;align-items:center;gap:10px;
    }
    .alert-err{background:var(--red-soft);color:#7A2322;border:1px solid #F1B3B0;}

    .ctx-banner{
        background:var(--green-soft);border:1px solid var(--green-tint);border-radius:12px;
        padding:14px 18px;margin-bottom:22px;display:flex;align-items:center;gap:12px;
    }
    .ctx-banner i{color:var(--green);font-size:1.1rem;}
    .ctx-banner div{font-size:.86rem;color:var(--green-dark);}
    .ctx-banner strong{font-weight:800;}

    .fg{margin-bottom:16px;}
    .fg label{display:block;font-size:.74rem;font-weight:700;color:var(--muted);margin-bottom:7px;text-transform:uppercase;letter-spacing:.05em;}
    .fg input, .fg select, .fg textarea{
        width:100%;padding:11px 13px;border:1.5px solid var(--border);
        border-radius:12px;font-size:.92rem;font-family:inherit;
        background:#fff;color:var(--text);transition:all .15s;
    }
    .fg input:focus, .fg select:focus, .fg textarea:focus{
        outline:none;border-color:var(--green);box-shadow:0 0 0 4px rgba(45,106,79,.12);
    }
    .fg textarea{resize:vertical;min-height:84px;}
    .form-error{color:var(--red);font-size:.78rem;margin-top:5px;display:block;}

    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    @@media(max-width:640px){.grid-2{grid-template-columns:1fr;}}

    .actions{display:flex;gap:10px;justify-content:flex-end;margin-top:22px;padding-top:18px;border-top:1px solid var(--border-soft);}
</style>
}

<a class="back-link" asp-action="ShowStoreProduct" asp-route-storeId="@Model.StoreId">
    <i class="fas fa-arrow-left"></i> Back to @Model.StoreName
</a>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-box alert-err"><i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
}

<div class="form-wrap">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3><i class="fas fa-exchange-alt" style="color:var(--green);margin-right:6px;"></i> Add Product to Store</h3>
                <div class="hd-sub">Set price, quantity and notes for this store</div>
            </div>
        </div>

        <div class="ctx-banner">
            <i class="fas fa-info-circle"></i>
            <div><strong>@Model.ProductName</strong> → <strong>@Model.StoreName</strong></div>
        </div>

        <form asp-action="AddProductToStore" method="post">
            <input type="hidden" asp-for="StoreId" />
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="StoreName" />
            <input type="hidden" asp-for="ProductName" />

            <div class="grid-2">
                <div class="fg">
                    <label asp-for="Price">Price</label>
                    <input asp-for="Price" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Price" class="form-error"></span>
                </div>

                <div class="fg">
                    <label asp-for="Count">Quantity</label>
                    <input asp-for="Count" type="number" min="1" max="@ViewBag.AvailableStock" />
                    <small style="display:block;color:var(--muted);font-size:.74rem;margin-top:5px;">
                        <i class="fas fa-warehouse"></i> In stock: <strong>@ViewBag.AvailableStock</strong>
                    </small>
                    <span asp-validation-for="Count" class="form-error"></span>
                </div>

                <div class="fg">
                    <label asp-for="unitOfmass">Unit</label>
                    <select asp-for="unitOfmass" id="unitSelect">
                        <option value="0">Select Unit</option>
                        @foreach (var unit in Enum.GetValues(typeof(Accounting_Software.Enums.Unit_of_mass)))
                        {
                            <option value="@unit">@unit</option>
                        }
                    </select>
                    <span asp-validation-for="unitOfmass" class="form-error"></span>
                </div>

                <div class="fg" id="massGroup">
                    <label asp-for="Mass">Mass</label>
                    <input asp-for="Mass" type="number" min="0" id="massInput" data-default="@Model.Mass" />
                    <span asp-validation-for="Mass" class="form-error"></span>
                </div>
            </div>

            <div class="fg">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" placeholder="Optional notes about this product..."></textarea>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>

            <div class="actions">
                <a class="btn btn-ghost" asp-action="ShowStoreProduct" asp-route-storeId="@Model.StoreId">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button class="btn btn-primary" type="submit">
                    <i class="fas fa-check"></i> Add to Store
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
<script>
    (function () {
        const unitSelect = document.getElementById('unitSelect');
        const massGroup = document.getElementById('massGroup');
        const massInput = document.getElementById('massInput');
        const defaultMass = massInput.getAttribute('data-default') || '0';

        // "Pcs" (штуки) и "Select Unit" имеют value "0" — масса для них не нужна
        function toggleMass() {
            const needsMass = unitSelect.value !== '0' && unitSelect.value !== 'Pcs';
            if (needsMass) {
                massGroup.style.display = '';
                // если поле пустое или 0 — подставляем массу по умолчанию из товара
                if (!massInput.value || massInput.value === '0') {
                    massInput.value = defaultMass;
                }
            } else {
                massGroup.style.display = 'none';
                massInput.value = 0; // штучный товар — масса не учитывается
            }
        }

        unitSelect.addEventListener('change', toggleMass);
        toggleMass();
    })();
</script>
}
