@model List<Accounting_Software.ViewModel.ProductViewModel>
@{
    Layout = "_FintegraLayout";
    var storeId = ViewBag.StoreId is int sid ? sid : 0;
    var storeName = ViewBag.StoreName as string ?? "Store";
    ViewBag.ActivePage = "stores";
    ViewBag.PageTitle = $"Add Products to {storeName}";
    ViewBag.PageHeading = $"Add Products to {storeName}";
    ViewBag.PageSubtitle = "Pick a product — pre-filled price and quantity, edit as needed";
}

@section Styles {
<style>
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .alert-box{
        padding:12px 16px;border-radius:12px;margin-bottom:16px;font-size:.86rem;font-weight:500;
        display:flex;align-items:center;gap:10px;
    }
    .alert-ok{background:var(--green-soft);color:var(--green-dark);border:1px solid var(--green-tint);}
    .alert-err{background:var(--red-soft);color:#7A2322;border:1px solid #F1B3B0;}

    .toolbar{
        background:var(--card);border-radius:var(--r);padding:12px 16px;
        box-shadow:var(--shadow-sm);margin-bottom:16px;
        display:flex;align-items:center;gap:10px;
    }
    .toolbar i{color:var(--muted);}
    .toolbar input{flex:1;border:none;outline:none;font-size:.92rem;font-family:inherit;background:transparent;color:var(--text);}
    .toolbar input::placeholder{color:var(--muted-soft);}

    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;}
    .p-card{
        background:var(--card);border:1px solid var(--border-soft);
        border-radius:var(--r-lg);padding:18px;display:flex;flex-direction:column;gap:10px;
        transition:all .15s;box-shadow:var(--shadow-sm);
    }
    .p-card:hover{border-color:var(--green-tint);box-shadow:var(--shadow-md);transform:translateY(-2px);}
    .p-name{font-size:1rem;font-weight:800;color:var(--text);}
    .p-seller{font-size:.78rem;color:var(--muted);display:inline-flex;align-items:center;gap:5px;}
    .p-meta{display:flex;gap:8px;flex-wrap:wrap;font-size:.78rem;color:var(--text);margin-top:4px;align-items:center;}
    .p-meta .chip{background:var(--green-soft);padding:3px 10px;border-radius:99px;font-weight:600;color:var(--muted);}
    .p-price{font-size:1.05rem;font-weight:800;color:var(--green);}
    .p-stock{display:inline-flex;align-items:center;background:var(--green-tint);color:var(--green);padding:3px 10px;border-radius:99px;font-size:.72rem;font-weight:700;}
    .p-stock.out{background:var(--red-soft);color:var(--red);}

    .btn-full{width:100%;justify-content:center;}
    .btn-disabled{background:var(--border-soft);color:var(--muted-soft);cursor:not-allowed;padding:9px 16px;border-radius:12px;font-size:.85rem;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:7px;width:100%;}

    .empty{
        background:var(--card);border-radius:var(--r-lg);padding:48px;
        text-align:center;color:var(--muted);box-shadow:var(--shadow-sm);
    }
    .empty .ic{width:64px;height:64px;border-radius:50%;background:var(--green-soft);color:var(--green);display:grid;place-items:center;font-size:1.4rem;margin:0 auto 12px;}
</style>
}

<a class="back-link" asp-action="ShowStoreProduct" asp-route-storeId="@storeId">
    <i class="fas fa-arrow-left"></i> Back to @storeName
</a>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-box alert-err"><i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-box alert-ok"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
}

@if (Model != null && Model.Any())
{
    <div class="toolbar">
        <i class="fas fa-search"></i>
        <input type="text" id="productSearch" placeholder="Search by product or seller name..." />
    </div>

    <div class="grid" id="productGrid">
        @foreach (var p in Model)
        {
            var outOfStock = p.Count <= 0;
            <div class="p-card" data-search="@((p.Name + " " + (p.SellerName ?? "")).ToLower())">
                <div>
                    <div class="p-name">@p.Name</div>
                    @if (!string.IsNullOrEmpty(p.SellerName))
                    {
                        <div class="p-seller"><i class="fas fa-user-tie"></i> @p.SellerName</div>
                    }
                </div>
                <div class="p-meta">
                    <span class="p-price">@p.Price.ToString("N2")</span>
                    <span class="chip">@p.Mass @p.unitOfmass</span>
                    <span class="p-stock @(outOfStock ? "out" : "")">stock: @p.Count</span>
                </div>
                @if (outOfStock)
                {
                    <button class="btn-disabled" disabled><i class="fas fa-ban"></i> Out of stock</button>
                }
                else
                {
                    <a class="btn btn-primary btn-full"
                       asp-action="AddProductToStore"
                       asp-route-storeId="@storeId"
                       asp-route-productId="@p.Id">
                        <i class="fas fa-plus"></i> Add to Store
                    </a>
                }
            </div>
        }
    </div>
}
else
{
    <div class="empty">
        <div class="ic"><i class="fas fa-box-open"></i></div>
        <h4 style="font-weight:700;color:var(--text);margin-bottom:6px;">No products available</h4>
        <p style="font-size:.86rem;margin-bottom:14px;">Add products to a seller first.</p>
        <a class="btn btn-primary" asp-controller="Seller" asp-action="Index">
            <i class="fas fa-user-tie"></i> Go to Sellers
        </a>
    </div>
}

<div style="margin-top:24px;">
    <a class="btn btn-ghost" asp-action="ShowStoreProduct" asp-route-storeId="@storeId">
        <i class="fas fa-arrow-left"></i> Back to @storeName
    </a>
</div>

@section Scripts {
<script>
    var search = document.getElementById('productSearch');
    if (search) {
        search.addEventListener('input', function () {
            var q = this.value.toLowerCase().trim();
            document.querySelectorAll('#productGrid .p-card').forEach(function (c) {
                var key = c.getAttribute('data-search') || '';
                c.style.display = key.includes(q) ? '' : 'none';
            });
        });
    }
</script>
}
