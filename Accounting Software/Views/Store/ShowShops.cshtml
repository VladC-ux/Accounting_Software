@model List<Accounting_Software.ViewModel.StoreProductViewModel>
@{
    Layout = "_FintegraLayout";
    ViewBag.ActivePage = "stores";
    ViewBag.PageTitle = "Choose Store";
    ViewBag.PageHeading = "Choose Store";
    ViewBag.PageSubtitle = "Select where to add this product";
}

@section Styles {
<style>
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .store-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;}
    .store-pick{
        display:flex;flex-direction:column;align-items:center;gap:10px;
        padding:24px 18px;background:var(--card);
        border:1px solid var(--border-soft);border-radius:var(--r-lg);
        text-decoration:none;transition:all .15s;cursor:pointer;
        box-shadow:var(--shadow-sm);
    }
    .store-pick:hover{
        border-color:var(--green);background:var(--green-soft);
        transform:translateY(-2px);box-shadow:var(--shadow-md);
        text-decoration:none;
    }
    .store-pick .ic{
        width:54px;height:54px;border-radius:14px;
        background:var(--green-tint);color:var(--green);
        display:grid;place-items:center;font-size:1.4rem;transition:all .15s;
    }
    .store-pick:hover .ic{background:var(--green);color:#fff;}
    .store-pick .name{font-size:.94rem;font-weight:700;color:var(--text);text-align:center;}
    .store-pick .arrow{font-size:.75rem;color:var(--muted-soft);}

    .empty-state{
        background:var(--card);border-radius:var(--r-lg);padding:48px;
        text-align:center;color:var(--muted);box-shadow:var(--shadow-sm);
    }
    .empty-state .ic{
        width:64px;height:64px;border-radius:50%;background:var(--green-soft);
        color:var(--green);display:grid;place-items:center;font-size:1.4rem;margin:0 auto 12px;
    }
</style>
}

<a class="back-link" asp-controller="Seller" asp-action="Index">
    <i class="fas fa-arrow-left"></i> Back to Products
</a>

@if (Model != null && Model.Any())
{
    <div class="store-grid">
        @foreach (var store in Model)
        {
            <a class="store-pick" href="@Url.Action("ShowStoreProduct", "Store", new { storeId = store.StoreId, add = ViewBag.ProductId })">
                <div class="ic"><i class="fas fa-store"></i></div>
                <div class="name">@store.StoreName</div>
                <div class="arrow"><i class="fas fa-arrow-right"></i></div>
            </a>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="ic"><i class="fas fa-store-slash"></i></div>
        <h4 style="font-weight:700;color:var(--text);margin-bottom:6px;">No stores available</h4>
        <p style="font-size:.86rem;margin-bottom:14px;">Create a store first to continue.</p>
        <a class="btn btn-primary" asp-action="Index">
            <i class="fas fa-plus"></i> Go to Stores
        </a>
    </div>
}

<div style="margin-top:24px;">
    <a class="btn btn-ghost" asp-controller="Seller" asp-action="Index">
        <i class="fas fa-arrow-left"></i> Back to Product List
    </a>
</div>
