@model List<Accounting_Software.ViewModel.StoreProductViewModel>
@{
    Layout = "_FintegraLayout";
    var storeName = (Model?.FirstOrDefault()?.StoreName) ?? (ViewBag.StoreName as string);
    var storeId = (Model?.FirstOrDefault()?.StoreId) ?? (ViewBag.StoreId is int sid ? sid : 0);
    var allProducts = ViewBag.AllProducts as List<Accounting_Software.ViewModel.ProductViewModel>
                      ?? new List<Accounting_Software.ViewModel.ProductViewModel>();
    var count = Model?.Count ?? 0;
    ViewBag.ActivePage = "stores";
    var storeLabel = storeName ?? Localizer["Store"].Value;
    ViewBag.PageTitle = $"{storeLabel} " + Localizer["Products"].Value;
    ViewBag.PageHeading = $"{storeLabel} " + Localizer["Products"].Value;
    ViewBag.PageSubtitle = $"{count} " + Localizer["items in stock"].Value;
    ViewBag.HeaderActions = $@"<button type='button' class='btn btn-primary' onclick='openQuickAdd()'><i class='fas fa-bolt'></i> {Localizer["Quick Add"].Value}</button>"
                          + $@"<a class='btn btn-ghost' href='/Store/PickProductForStore?storeId={storeId}'><i class='fas fa-th-large'></i> {Localizer["Browse Products"].Value}</a>";
}

@section Styles {
<style>
    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:600;color:var(--muted);margin-bottom:16px;transition:color .15s;}
    .back-link:hover{color:var(--green);}

    .alert-box{
        padding:12px 16px;border-radius:12px;margin-bottom:16px;font-size:.86rem;font-weight:500;
        display:flex;align-items:center;gap:10px;
    }
    .alert-ok{background:var(--green-soft);color:var(--green-dark);border:1px solid var(--green-tint);}
    .alert-err{background:var(--red-soft);color:#7A2322;border:1px solid #F1B3B0;}

    .tbl-wrap{overflow-x:auto;}
    table.s-table{width:100%;border-collapse:collapse;font-size:.86rem;}
    .s-table th{
        background:var(--green-soft);color:var(--muted);font-weight:700;
        font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;
        padding:11px 14px;text-align:left;border-bottom:1px solid var(--border-soft);white-space:nowrap;
    }
    .s-table td{padding:14px;border-bottom:1px solid var(--border-soft);color:var(--text);vertical-align:middle;}
    .s-table tr:last-child td{border-bottom:none;}
    .s-table tbody tr:hover td{background:var(--green-soft);}

    .product-name{font-weight:700;color:var(--text);}
    .product-desc{font-size:.76rem;color:var(--muted);margin-top:2px;}
    .price{font-weight:700;color:var(--green);white-space:nowrap;}
    .count-pill{display:inline-flex;align-items:center;background:var(--green-tint);color:var(--green);padding:3px 10px;border-radius:99px;font-size:.78rem;font-weight:700;}
    .count-pill.low{background:var(--orange-soft);color:var(--orange);}
    .count-pill.out{background:var(--red-soft);color:var(--red);}

    .row-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;align-items:center;}
    .row-actions form{display:inline;}
    .btn-icon-sm{padding:7px 12px;border-radius:10px;font-size:.78rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:5px;border:none;cursor:pointer;transition:all .15s;}
    .btn-sale{background:var(--green);color:#fff;}
    .btn-sale:hover{background:var(--green-dark);color:#fff;text-decoration:none;}
    .btn-sale:disabled{background:var(--border);color:var(--muted-soft);cursor:not-allowed;}
    .btn-edit{background:var(--orange-soft);color:var(--orange);}
    .btn-edit:hover{background:var(--orange);color:#fff;text-decoration:none;}
    .btn-del{background:var(--red-soft);color:var(--red);}
    .btn-del:hover{background:var(--red);color:#fff;}
    .qty-input{width:64px;padding:6px 8px;border:1.5px solid var(--border);border-radius:8px;font-size:.78rem;font-family:inherit;text-align:right;}
    .qty-input:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px rgba(45,106,79,.12);}
    .qty-input:disabled{background:var(--green-soft);color:var(--muted-soft);cursor:not-allowed;}
    .unit-label{font-size:.74rem;color:var(--muted);font-weight:600;margin-right:2px;}

    .empty{padding:48px;text-align:center;color:var(--muted);}
    .empty .ic{width:64px;height:64px;border-radius:50%;background:var(--green-soft);color:var(--green);display:grid;place-items:center;font-size:1.4rem;margin:0 auto 12px;}

    .modal-backdrop{position:fixed;inset:0;background:rgba(26,43,35,.55);display:none;align-items:flex-start;justify-content:center;z-index:1000;overflow-y:auto;padding:40px 16px;}
    .modal-backdrop.open{display:flex;}
    .modal-card{background:var(--card);border-radius:var(--r-lg);width:100%;max-width:560px;box-shadow:0 22px 60px rgba(0,0,0,.25);overflow:hidden;}
    .modal-hd{padding:18px 22px;border-bottom:1px solid var(--border-soft);display:flex;align-items:center;justify-content:space-between;}
    .modal-hd h2{font-size:1.05rem;font-weight:800;color:var(--text);display:flex;align-items:center;gap:8px;}
    .modal-close{background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;padding:4px 10px;border-radius:8px;}
    .modal-close:hover{background:var(--green-soft);color:var(--text);}
    .modal-body{padding:22px;}
    .modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:18px;padding-top:16px;border-top:1px solid var(--border-soft);}

    .fg{margin-bottom:14px;}
    .fg label{display:block;font-size:.74rem;font-weight:700;color:var(--muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;}
    .fg input, .fg select, .fg textarea{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:10px;font-size:.88rem;font-family:inherit;background:#fff;color:var(--text);transition:all .15s;}
    .fg input:focus, .fg select:focus, .fg textarea:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px rgba(45,106,79,.12);}
    .fg textarea{resize:vertical;min-height:64px;}
    .fg-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    @@media(max-width:480px){.fg-row{grid-template-columns:1fr;}}
    .hint{font-size:.72rem;color:var(--muted);margin-top:4px;}

    .warn-box{padding:14px 16px;background:var(--orange-soft);color:#7A4A12;border-radius:12px;font-size:.86rem;display:flex;gap:8px;align-items:flex-start;}
    .warn-box i{color:var(--orange);margin-top:2px;}

    .stock-banner{background:var(--green-soft);border:1px solid var(--green-tint);border-radius:12px;padding:11px 14px;margin-bottom:14px;font-size:.84rem;color:var(--green-dark);display:flex;align-items:center;gap:9px;}
    .stock-banner i{color:var(--green);}
</style>
}

<a class="back-link" asp-action="Index">
    <i class="fas fa-arrow-left"></i> @Localizer["Back to Stores"]
</a>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-box alert-err"><i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    var lastInvoiceId = TempData["LastInvoiceId"] as int?;
    <div class="alert-box alert-ok" style="justify-content:space-between;">
        <span><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</span>
        @if (lastInvoiceId.HasValue)
        {
            <a class="btn-icon-sm btn-sale" asp-controller="Invoice" asp-action="Pdf" asp-route-id="@lastInvoiceId.Value" target="_blank">
                <i class="fas fa-file-pdf"></i> @Localizer["Download Invoice"]
            </a>
        }
    </div>
}

<div class="card">
    @if (Model != null && Model.Any())
    {
        <div class="tbl-wrap">
            <table class="s-table">
                <thead>
                    <tr>
                        <th>@Localizer["Product"]</th>
                        <th>@Localizer["Seller"]</th>
                        <th>@Localizer["Price"]</th>
                        <th>@Localizer["Mass"]</th>
                        <th>@Localizer["Stock"]</th>
                        <th>@Localizer["Added"]</th>
                        <th style="text-align:right;">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        var countClass = product.Count == 0 ? "out" : product.Count <= 5 ? "low" : "";
                        <tr>
                            <td>
                                <div class="product-name">@product.ProductName</div>
                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    <div class="product-desc">@product.Description</div>
                                }
                            </td>
                            <td>@product.SellerName</td>
                            <td class="price">@product.Price.ToString("N2")</td>
                            <td>@product.Mass @product.unitOfmass</td>
                            <td><span class="count-pill @countClass">@product.Count @Localizer["pcs"]</span></td>
                            <td style="color:var(--muted);font-size:.8rem;">@product.AddDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="row-actions">
                                    <form asp-action="Sell" method="post" style="display:inline-flex;gap:4px;align-items:center;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="storeProductId" value="@product.Id" />
                                        <input type="number" name="quantity" value="1" min="1" max="@product.Count"
                                               class="qty-input" title="@Localizer["Quantity in"] @product.unitOfmass"
                                               @(product.Count <= 0 ? "disabled" : "") />
                                        <span class="unit-label">@product.unitOfmass</span>
                                        <button class="btn-icon-sm btn-sale" type="submit" @(product.Count <= 0 ? "disabled" : "")>
                                            <i class="fas fa-cash-register"></i> @Localizer["Sell"]
                                        </button>
                                    </form>
                                    <a class="btn-icon-sm btn-edit" href="/Store/EditAllStore/@product.Id">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="DeleteStoreProduct" method="post"
                                          onsubmit="return confirm('@Localizer["Delete this product?"]');">
                                        <input type="hidden" name="Id" value="@product.Id" />
                                        <input type="hidden" name="ProductId" value="@product.ProductId" />
                                        <input type="hidden" name="StoreId" value="@product.StoreId" />
                                        <button class="btn-icon-sm btn-del" type="submit">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty">
            <div class="ic"><i class="fas fa-box"></i></div>
            <p style="font-size:.9rem;">@Localizer["No products in this store yet"]</p>
        </div>
    }
</div>

<div style="margin-top:24px;">
    <a class="btn btn-ghost" asp-action="Index"><i class="fas fa-arrow-left"></i> @Localizer["Back to Stores"]</a>
</div>

<div id="quickAddModal" class="modal-backdrop" onclick="if(event.target===this)closeQuickAdd()">
    <div class="modal-card">
        <div class="modal-hd">
            <h2><i class="fas fa-bolt" style="color:var(--green);"></i> @Localizer["Quick Add to"] @(storeName ?? Localizer["Store"].Value)</h2>
            <button type="button" class="modal-close" onclick="closeQuickAdd()"><i class="fas fa-times"></i></button>
        </div>
        <div class="modal-body">
            @if (!allProducts.Any())
            {
                <div class="warn-box">
                    <i class="fas fa-exclamation-triangle"></i>
                    @Localizer["No products available. Add products to a seller first."]
                </div>
            }
            else
            {
                <form asp-action="AddProductToStore" method="post">
                    <input type="hidden" name="StoreId" value="@storeId" />
                    <input type="hidden" name="StoreName" value="@storeName" />
                    <input type="hidden" name="ProductName" id="qa_ProductName" />
                    @* Единица и масса наследуются от товара — пользователь их не выбирает *@
                    <input type="hidden" name="unitOfmass" id="qa_Unit" value="0" />
                    <input type="hidden" name="Mass" id="qa_Mass" value="0" />

                    <div class="fg">
                        <label for="qa_ProductId">@Localizer["Product"]</label>
                        <select name="ProductId" id="qa_ProductId" required onchange="fillFromProduct()">
                            <option value="">@Localizer["— Select a product —"]</option>
                            @foreach (var p in allProducts)
                            {
                                <option value="@p.Id"
                                        data-name="@p.Name"
                                        data-price="@p.Price"
                                        data-mass="@p.Mass"
                                        data-unit="@((int)p.unitOfmass)"
                                        data-unitname="@p.unitOfmass"
                                        data-stock="@p.Count"
                                        data-desc="@p.Description"
                                        data-seller="@p.SellerName">
                                    @p.Name @(string.IsNullOrEmpty(p.SellerName) ? "" : " — " + p.SellerName) (@Localizer["stock:"] @p.Count)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="stock-banner" id="qa_StockBanner" style="display:none;">
                        <i class="fas fa-warehouse"></i>
                        <span id="qa_StockText"></span>
                    </div>

                    <div class="fg-row">
                        <div class="fg">
                            <label for="qa_Price">@Localizer["Price"]</label>
                            <input type="number" step="0.01" min="0.01" name="Price" id="qa_Price" required />
                        </div>
                        <div class="fg">
                            <label for="qa_Count" id="qa_CountLabel">@Localizer["Quantity"]</label>
                            <input type="number" min="1" name="Count" id="qa_Count" required oninput="updateTransfer()" />
                            <div class="hint" id="qa_StockHint"></div>
                        </div>
                    </div>

                    <div class="fg">
                        <label for="qa_Description">@Localizer["Description"]</label>
                        <textarea name="Description" id="qa_Description" placeholder="@Localizer["Optional notes..."]"></textarea>
                    </div>

                    <div class="modal-actions">
                        <button type="button" class="btn btn-ghost" onclick="closeQuickAdd()">@Localizer["Cancel"]</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> @Localizer["Add to Store"]</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openQuickAdd(){document.getElementById('quickAddModal').classList.add('open');}
    function closeQuickAdd(){document.getElementById('quickAddModal').classList.remove('open');}

    // 0 = Pcs (штучный товар). Для него масса не нужна.
    function isPieceUnit(unitVal){ return unitVal === '0' || unitVal === 0; }

    function fillFromProduct(){
        var sel=document.getElementById('qa_ProductId');
        var opt=sel.options[sel.selectedIndex];
        if(!opt||!opt.value){return;}

        document.getElementById('qa_ProductName').value = opt.dataset.name || '';
        document.getElementById('qa_Price').value = opt.dataset.price || '';
        document.getElementById('qa_Description').value = opt.dataset.desc || '';

        // Единица и масса наследуются от товара (скрытые поля)
        var unit = opt.dataset.unit || '0';
        var unitName = opt.dataset.unitname || 'Pcs';
        var mass = parseInt(opt.dataset.mass) || 0;
        document.getElementById('qa_Unit').value = unit;
        document.getElementById('qa_Mass').value = isPieceUnit(unit) ? 0 : mass;

        var stock = parseInt(opt.dataset.stock) || 0;
        var c = document.getElementById('qa_Count');
        c.max = stock;
        if(!c.value || parseInt(c.value) > stock){ c.value = stock > 0 ? 1 : 0; }
        document.getElementById('qa_CountLabel').textContent = isPieceUnit(unit) ? '@Localizer["Quantity (pcs)"]' : '@Localizer["Quantity (units)"]';

        // Баннер с остатком на складе в правильных единицах
        var banner = document.getElementById('qa_StockBanner');
        var stockText = document.getElementById('qa_StockText');
        banner.style.display = 'flex';
        if(isPieceUnit(unit)){
            stockText.innerHTML = '@Localizer["In stock:"] <strong>' + stock + ' @Localizer["pcs"]</strong>';
        } else {
            var totalKg = stock * mass;
            stockText.innerHTML = '@Localizer["In stock:"] <strong>' + stock + ' @Localizer["units"] &times; ' + mass + ' ' + unitName +
                                  ' = ' + totalKg + ' ' + unitName + '</strong>';
        }
        updateTransfer();
    }

    // Показывает, сколько фактически переносится (для весовых — в единицах массы)
    function updateTransfer(){
        var sel=document.getElementById('qa_ProductId');
        var opt=sel.options[sel.selectedIndex];
        var hint=document.getElementById('qa_StockHint');
        if(!opt||!opt.value){ hint.textContent=''; return; }
        var unit = opt.dataset.unit || '0';
        var unitName = opt.dataset.unitname || 'Pcs';
        var mass = parseInt(opt.dataset.mass) || 0;
        var count = parseInt(document.getElementById('qa_Count').value) || 0;
        if(isPieceUnit(unit)){
            hint.textContent = '@Localizer["Adding"] ' + count + ' @Localizer["pcs"]';
        } else {
            hint.textContent = '@Localizer["Adding"] ' + count + ' @Localizer["units"] = ' + (count * mass) + ' ' + unitName;
        }
    }

    function openQuickAddFor(productId){
        var sel=document.getElementById('qa_ProductId');
        if(!sel){return;}
        sel.value=String(productId);
        if(sel.value===String(productId)){
            fillFromProduct();
            openQuickAdd();
        }
    }

    document.addEventListener('keydown',function(e){if(e.key==='Escape')closeQuickAdd();});

    // Если пришли из Browse Products (?add=<productId>) — сразу открываем модалку с этим товаром
    (function(){
        var params=new URLSearchParams(window.location.search);
        var add=params.get('add');
        if(add){ openQuickAddFor(add); }
    })();
</script>
}
