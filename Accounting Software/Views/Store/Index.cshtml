@model IEnumerable<Accounting_Software.Data.Entities.Store>
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stores — Accounting Software</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.6.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        body{font-family:'Inter',sans-serif;background:#f4f6f9;color:#1c2434;min-height:100vh;}
        .topbar{height:56px;background:#fff;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:200;}
        .brand{font-size:0.92rem;font-weight:700;color:#111827;display:flex;align-items:center;gap:8px;}
        .brand-dot{width:7px;height:7px;background:#2563eb;border-radius:50%;}
        .top-nav{display:flex;gap:2px;margin-left:32px;}
        .tn{color:#6b7280;font-size:0.8rem;font-weight:500;padding:5px 10px;border-radius:6px;text-decoration:none;}
        .tn:hover{background:#f3f4f6;color:#111827;text-decoration:none;}
        .tn.active{color:#2563eb;font-weight:600;}
        .btn-logout{font-size:0.78rem;color:#9ca3af;text-decoration:none;padding:5px 10px;border-radius:6px;}
        .btn-logout:hover{background:#fef2f2;color:#dc2626;text-decoration:none;}

        .wrap{max-width:1100px;margin:32px auto;padding:0 24px;}
        .pg-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;}
        .pg-title h1{font-size:1.35rem;font-weight:700;color:#111827;display:flex;align-items:center;gap:10px;}
        .pg-title .sub{font-size:0.82rem;color:#9ca3af;margin-top:3px;}

        .btn{padding:9px 18px;border-radius:8px;font-size:0.85rem;font-weight:600;border:none;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px;transition:all .15s;}
        .btn-primary{background:#2563eb;color:#fff;}
        .btn-primary:hover{background:#1d4ed8;color:#fff;text-decoration:none;}
        .btn-ghost{background:#fff;color:#374151;border:1px solid #e5e7eb;}
        .btn-ghost:hover{background:#f9fafb;color:#111827;text-decoration:none;}
        .btn-danger{background:#fff;color:#dc2626;border:1px solid #fca5a5;}
        .btn-danger:hover{background:#fef2f2;color:#dc2626;text-decoration:none;}

        .store-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;}
        .store-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:20px;transition:all .15s;display:flex;flex-direction:column;gap:14px;}
        .store-card:hover{border-color:#bfdbfe;box-shadow:0 4px 12px rgba(37,99,235,.08);transform:translateY(-2px);}
        .store-head{display:flex;align-items:center;gap:12px;}
        .store-icon{width:42px;height:42px;border-radius:10px;background:#eff6ff;color:#2563eb;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;}
        .store-name{font-size:1rem;font-weight:700;color:#111827;text-decoration:none;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
        .store-name:hover{color:#2563eb;text-decoration:none;}
        .store-actions{display:flex;gap:8px;}
        .store-actions a, .store-actions button{flex:1;padding:7px 0;font-size:0.78rem;border-radius:7px;text-align:center;text-decoration:none;font-weight:600;}
        .ico-btn{background:#f3f4f6;color:#374151;border:none;cursor:pointer;}
        .ico-btn:hover{background:#e5e7eb;color:#111827;text-decoration:none;}
        .ico-btn.danger:hover{background:#fef2f2;color:#dc2626;}

        .empty{background:#fff;border:2px dashed #e5e7eb;border-radius:12px;padding:48px;text-align:center;color:#9ca3af;}
        .empty i{font-size:2rem;display:block;margin-bottom:10px;color:#cbd5e1;}
        .empty p{font-size:0.95rem;margin-bottom:18px;}
    </style>
</head>
<body>

<header class="topbar">
    <div style="display:flex;align-items:center;">
        <div class="brand"><span class="brand-dot"></span> Accounting Software</div>
        <nav class="top-nav">
            <a class="tn" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="tn" asp-controller="Seller" asp-action="Index">Sellers</a>
            <a class="tn active" asp-controller="Store" asp-action="Index">Stores</a>
            <a class="tn" asp-controller="Statistics" asp-action="Index">Reports</a>
            <a class="tn" asp-controller="Telegram" asp-action="Index">Telegram</a>
        </nav>
    </div>
    <a class="btn-logout" asp-controller="Auth" asp-action="Logout"><i class="fas fa-sign-out-alt"></i> Sign out</a>
</header>

<div class="wrap">

    <div class="pg-head">
        <div class="pg-title">
            <h1><i class="fas fa-store" style="color:#2563eb;"></i> Stores</h1>
            <div class="sub">@(Model?.Count() ?? 0) location@((Model?.Count() ?? 0) == 1 ? "" : "s")</div>
        </div>
        <a class="btn btn-primary" asp-action="Add">
            <i class="fas fa-plus"></i> New Store
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="store-grid">
            @foreach (var store in Model)
            {
                <div class="store-card">
                    <div class="store-head">
                        <div class="store-icon"><i class="fas fa-store"></i></div>
                        <a class="store-name" asp-action="ShowStoreProduct" asp-route-storeId="@store.Id">@store.StoreName</a>
                    </div>
                    <div class="store-actions">
                        <a class="ico-btn" asp-action="ShowStoreProduct" asp-route-storeId="@store.Id" title="Products">
                            <i class="fas fa-box"></i> Products
                        </a>
                        <a class="ico-btn" asp-action="Edit" asp-route-id="@store.Id" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a class="ico-btn danger" asp-action="Delete" asp-route-id="@store.Id" title="Delete"
                           onclick="return confirm('Delete this store?');">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty">
            <i class="fas fa-store-slash"></i>
            <p>No stores yet</p>
            <a class="btn btn-primary" asp-action="Add"><i class="fas fa-plus"></i> Create your first store</a>
        </div>
    }

    <div style="margin-top:24px;">
        <a class="btn btn-ghost" asp-controller="Dashboard" asp-action="Index">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

</div>
</body>
</html>
