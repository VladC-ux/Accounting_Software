@model IEnumerable<Accounting_Software.Data.Entities.Store>
@{
    Layout = "_FintegraLayout";
    var storeCount = Model?.Count() ?? 0;

    ViewBag.ActivePage = "stores";
    ViewBag.PageTitle = Localizer["Stores"].Value;
    ViewBag.PageHeading = Localizer["Stores"].Value;
    var locationWord = storeCount == 1 ? Localizer["location"].Value : Localizer["locations"].Value;
    ViewBag.PageSubtitle = storeCount + " " + locationWord + " · " + Localizer["Manage your retail points"].Value;
    ViewBag.HeaderActions =
        "<div class='search-pill'>"
        + "<i class='fas fa-search'></i>"
        + "<input type='text' id='storeSearch' placeholder='" + Localizer["Search stores..."].Value + "' />"
        + "</div>"
        + "<a class='btn btn-primary' href='/Store/Add'><i class='fas fa-plus'></i> " + Localizer["New Store"].Value + "</a>";
}

@section Styles {
<style>
    .search-pill{
        display:inline-flex;align-items:center;gap:8px;
        padding:9px 14px;background:var(--card);border:1px solid var(--border-soft);
        border-radius:12px;box-shadow:var(--shadow-xs);min-width:240px;
    }
    .search-pill i{color:var(--muted);font-size:.85rem;}
    .search-pill input{border:none;outline:none;background:transparent;flex:1;font-family:inherit;font-size:.85rem;color:var(--text);}
    .search-pill input::placeholder{color:var(--muted-soft);}

    .store-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;}
    .store-card{
        background:var(--card);border-radius:var(--r-lg);padding:22px;
        box-shadow:var(--shadow-sm);
        display:flex;flex-direction:column;gap:16px;
        transition:transform .18s, box-shadow .18s;position:relative;overflow:hidden;
    }
    .store-card::before{
        content:'';position:absolute;top:0;left:0;right:0;height:3px;
        background:linear-gradient(90deg,var(--green),var(--orange));opacity:0;transition:opacity .18s;
    }
    .store-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);}
    .store-card:hover::before{opacity:1;}

    .store-head{display:flex;align-items:center;gap:14px;}
    .store-icon{
        width:48px;height:48px;border-radius:14px;
        background:var(--green-tint);color:var(--green);
        display:grid;place-items:center;font-size:1.15rem;flex-shrink:0;
    }
    .store-card:hover .store-icon{background:var(--green);color:#fff;}
    .store-info{min-width:0;flex:1;}
    .store-name{
        font-size:1rem;font-weight:700;color:var(--text);letter-spacing:-.01em;
        display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
    }
    .store-name:hover{color:var(--green);}
    .store-meta{font-size:.74rem;color:var(--muted);margin-top:3px;display:flex;align-items:center;gap:6px;}
    .store-meta .dot{width:6px;height:6px;background:var(--green-light);border-radius:50%;}

    .store-actions{display:flex;gap:6px;padding-top:14px;border-top:1px dashed var(--border-soft);}
    .store-actions a{
        flex:1;padding:8px 10px;border-radius:10px;
        font-size:.76rem;font-weight:600;text-align:center;
        display:inline-flex;align-items:center;justify-content:center;gap:5px;
        transition:all .15s;
    }
    .a-products{background:var(--green-tint);color:var(--green);}
    .a-products:hover{background:var(--green);color:#fff;}
    .a-edit{background:var(--orange-soft);color:var(--orange);flex:0 0 auto;min-width:38px;}
    .a-edit:hover{background:var(--orange);color:#fff;}
    .a-del{background:var(--card);color:var(--red);border:1px solid var(--red-soft);flex:0 0 auto;min-width:38px;}
    .a-del:hover{background:var(--red-soft);}
</style>
}

@if (Model != null && Model.Any())
{
    <div class="store-grid">
        @foreach (var store in Model)
        {
            <div class="store-card" data-name="@store.StoreName.ToLower()">
                <div class="store-head">
                    <div class="store-icon"><i class="fas fa-store"></i></div>
                    <div class="store-info">
                        <a class="store-name" asp-action="ShowStoreProduct" asp-route-storeId="@store.Id">@store.StoreName</a>
                        <div class="store-meta"><span class="dot"></span> @Localizer["Active"] · ID #@store.Id</div>
                    </div>
                </div>
                <div class="store-actions">
                    <a class="a-products" asp-action="ShowStoreProduct" asp-route-storeId="@store.Id">
                        <i class="fas fa-box"></i> @Localizer["Products"]
                    </a>
                    <a class="a-edit" asp-action="Edit" asp-route-id="@store.Id" title="@Localizer["Edit"]">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a class="a-del" asp-action="Delete" asp-route-id="@store.Id" title="@Localizer["Delete"]"
                       onclick="return confirm('@Localizer["Delete this store?"]');">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-ico"><i class="fas fa-store-slash"></i></div>
        <h4>@Localizer["No stores yet"]</h4>
        <p>@Localizer["Create your first store to start managing inventory."]</p>
        <a class="btn btn-primary" asp-action="Add"><i class="fas fa-plus"></i> @Localizer["Create your first store"]</a>
    </div>
}

@section Scripts {
<script>
    var input = document.getElementById('storeSearch');
    if (input) {
        input.addEventListener('input', function () {
            var q = this.value.toLowerCase().trim();
            document.querySelectorAll('.store-card').forEach(function (card) {
                var name = card.getAttribute('data-name') || '';
                card.style.display = name.indexOf(q) >= 0 ? '' : 'none';
            });
        });
    }
</script>
}
