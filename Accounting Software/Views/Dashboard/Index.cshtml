@using System.Globalization
@model Accounting_Software.ViewModel.DashboardViewModel
@{
    Layout = "_FintegraLayout";
    var inv = CultureInfo.InvariantCulture;
    var enCulture = new CultureInfo("en-US");

    var profit = Model.TotalEarned - Model.TotalSpent;
    var monthProfit = Model.MonthEarned - Model.MonthSpent;
    var prevMonthProfit = Model.PrevMonthEarned - Model.PrevMonthSpent;

    double PctChange(decimal current, decimal prev)
    {
        if (prev == 0) return current == 0 ? 0 : 100;
        return (double)((current - prev) / Math.Abs(prev)) * 100;
    }

    var pctProfit  = PctChange(monthProfit, prevMonthProfit);
    var pctIncome  = PctChange(Model.MonthEarned, Model.PrevMonthEarned);
    var pctExpense = PctChange(Model.MonthSpent, Model.PrevMonthSpent);
    var pctBalance = PctChange(Model.Balance, Model.PrevMonthBalance);

    string Fmt(double v) => v.ToString("F2", inv);
    string FmtMoney(decimal v) => v.ToString("N2", inv);

    string Sparkline(List<decimal> data, string color, int w = 160, int h = 44)
    {
        if (data == null || data.Count == 0) return "";
        var min = (double)data.Min();
        var max = (double)data.Max();
        var range = max - min;
        if (range == 0) range = 1;
        var step = data.Count > 1 ? (double)w / (data.Count - 1) : 0;
        var pts = new System.Text.StringBuilder();
        var area = new System.Text.StringBuilder();
        for (int i = 0; i < data.Count; i++)
        {
            var x = i * step;
            var y = h - 4 - ((double)data[i] - min) / range * (h - 8);
            if (i > 0) { pts.Append(' '); area.Append(' '); }
            pts.Append(x.ToString("F1", inv)).Append(',').Append(y.ToString("F1", inv));
            area.Append(x.ToString("F1", inv)).Append(',').Append(y.ToString("F1", inv));
        }
        var lastX = (data.Count - 1) * step;
        var fillId = "fill-" + Guid.NewGuid().ToString("N").Substring(0, 6);
        var areaPath = $"M0,{(h).ToString("F1", inv)} L{area} L{lastX.ToString("F1", inv)},{(h).ToString("F1", inv)} Z";
        return $@"<svg class=""spark"" viewBox=""0 0 {w} {h}"" preserveAspectRatio=""none"" xmlns=""http://www.w3.org/2000/svg"">
                    <defs>
                      <linearGradient id=""{fillId}"" x1=""0"" x2=""0"" y1=""0"" y2=""1"">
                        <stop offset=""0%"" stop-color=""{color}"" stop-opacity=""0.25""/>
                        <stop offset=""100%"" stop-color=""{color}"" stop-opacity=""0""/>
                      </linearGradient>
                    </defs>
                    <path d=""{areaPath}"" fill=""url(#{fillId})""/>
                    <polyline points=""{pts}"" fill=""none"" stroke=""{color}"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round""/>
                  </svg>";
    }

    decimal flowMax = 0;
    foreach (var p in Model.Flow) { flowMax = Math.Max(flowMax, Math.Max(p.Income, p.Expense)); }
    if (flowMax == 0) flowMax = 1;

    var breakdownTotal = Model.Breakdown.Sum(b => b.Amount);

    var donutSegments = new List<(double Seg, double Offset, string Color)>();
    {
        double offset = 25;
        foreach (var s in Model.Breakdown)
        {
            donutSegments.Add((s.Percent, offset, s.Color));
            offset -= s.Percent;
            if (offset < 0) offset += 100;
        }
    }

    ViewBag.ActivePage = "dashboard";
    ViewBag.PageTitle = "Dashboard";
    ViewBag.PageHeading = "Overview";
    ViewBag.PageSubtitle = DateTime.Now.ToString("dddd, d MMMM yyyy", enCulture) + " · " + Model.UserName;
    var monthLabel = monthProfit >= 0 ? "Monthly profit" : "Monthly loss";
    var monthValue = (monthProfit >= 0 ? "+" : "") + FmtMoney(monthProfit);
    ViewBag.SidebarFoot = "<div class='sb-foot'>"
        + "<div class='sb-foot-ico'><i class='far fa-calendar'></i></div>"
        + "<div class='sb-foot-text'>"
        + "<div class='sb-foot-lbl'>" + monthLabel + "</div>"
        + "<div class='sb-foot-val'>" + monthValue + "</div>"
        + "</div>"
        + "</div>";
}

@section Styles {
<style>
    /* ── KPI ROW ── */
    .kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:22px;}
    .kpi{
        background:var(--card);border-radius:var(--r-lg);padding:20px 20px 14px;
        box-shadow:var(--shadow-sm);position:relative;overflow:hidden;
    }
    .kpi-lbl{font-size:.78rem;color:var(--muted);font-weight:500;margin-bottom:8px;}
    .kpi-val{font-size:1.55rem;font-weight:800;letter-spacing:-.02em;color:var(--text);}
    .kpi-delta{
        display:inline-flex;align-items:center;gap:6px;
        font-size:.78rem;font-weight:600;margin-top:8px;
    }
    .kpi-delta.up{color:var(--green);}
    .kpi-delta.down{color:var(--red);}
    .kpi-delta .vs{color:var(--muted);font-weight:500;margin-left:4px;}
    .kpi .spark{display:block;width:100%;height:40px;margin-top:6px;}

    /* ── CONTENT GRID ── */
    .content-row{display:grid;grid-template-columns:1.5fr 1fr;gap:18px;margin-bottom:22px;}

    /* ── CASH FLOW ── */
    .flow-legend{display:flex;align-items:center;gap:18px;margin-bottom:14px;}
    .lg{display:inline-flex;align-items:center;gap:7px;font-size:.78rem;color:var(--muted);font-weight:600;}
    .lg .chip{width:10px;height:10px;border-radius:3px;}
    .lg .chip.in{background:var(--green);}
    .lg .chip.out{background:var(--orange);}

    .flow-chart{display:flex;align-items:flex-end;gap:14px;height:200px;padding:14px 0 4px;border-top:1px dashed var(--border-soft);position:relative;}
    .flow-yaxis{position:absolute;left:0;top:0;bottom:24px;display:flex;flex-direction:column-reverse;justify-content:space-between;font-size:.66rem;color:var(--muted-soft);pointer-events:none;}
    .flow-bars{flex:1;display:flex;align-items:flex-end;justify-content:space-around;gap:6px;height:100%;padding-left:32px;}
    .bar-group{flex:1;display:flex;flex-direction:column;align-items:center;height:100%;}
    .bar-pair{flex:1;display:flex;align-items:flex-end;gap:5px;width:100%;justify-content:center;}
    .bar{width:14px;border-radius:5px 5px 0 0;transition:height .4s;min-height:2px;}
    .bar.in{background:linear-gradient(180deg,#52B788 0%,#2D6A4F 100%);}
    .bar.out{background:linear-gradient(180deg,#F4C77B 0%,#E89A3C 100%);}
    .bar-label{font-size:.7rem;color:var(--muted);margin-top:8px;font-weight:500;}

    /* ── DONUT ── */
    .donut-wrap{display:flex;align-items:center;gap:18px;}
    .donut-svg-wrap{position:relative;width:160px;height:160px;flex-shrink:0;}
    .donut-center{position:absolute;inset:0;display:grid;place-items:center;text-align:center;}
    .donut-center .v{font-size:1.05rem;font-weight:800;letter-spacing:-.02em;line-height:1.1;}
    .donut-center .l{font-size:.7rem;color:var(--muted);margin-top:2px;}
    .donut-legend{flex:1;display:flex;flex-direction:column;gap:9px;}
    .lg-row{display:flex;align-items:center;gap:9px;font-size:.8rem;}
    .lg-row .chip{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
    .lg-row .nm{flex:1;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .lg-row .pc{font-weight:700;color:var(--text);font-variant-numeric:tabular-nums;}

    /* ── ACTIONS + ACTIVITY ── */
    .lower-row{display:grid;grid-template-columns:1.5fr 1fr;gap:18px;}
    .action-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
    .action-tile{border:1px solid var(--border-soft);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px;background:#fff;transition:all .15s;}
    .action-tile:hover{border-color:var(--green);background:var(--green-soft);transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .tile-icon{width:38px;height:38px;border-radius:11px;background:var(--green-tint);display:grid;place-items:center;color:var(--green);font-size:.95rem;transition:all .15s;}
    .action-tile:hover .tile-icon{background:var(--green);color:#fff;}
    .tile-label{font-size:.86rem;font-weight:700;color:var(--text);}
    .tile-desc{font-size:.74rem;color:var(--muted);line-height:1.4;}

    .activity-item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--border-soft);}
    .activity-item:last-child{border-bottom:none;}
    .act-icon{width:36px;height:36px;border-radius:11px;flex-shrink:0;display:grid;place-items:center;font-size:.85rem;}
    .act-icon.buy{background:var(--red-soft);color:var(--red);}
    .act-icon.sale{background:var(--green-tint);color:var(--green);}
    .act-icon.dep{background:var(--orange-soft);color:var(--orange);}
    .act-info{flex:1;min-width:0;}
    .act-name{font-size:.84rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .act-date{font-size:.72rem;color:var(--muted);margin-top:2px;}
    .act-amt{font-size:.86rem;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap;}
    .act-amt.neg{color:var(--red);}
    .act-amt.pos{color:var(--green);}
    .act-amt.dep{color:var(--orange);}

    .small-empty{text-align:center;padding:28px 14px;color:var(--muted);}
    .small-empty i{font-size:1.6rem;margin-bottom:8px;color:var(--border);}
    .small-empty div{font-size:.84rem;}

    @@media(max-width:1200px){
        .content-row,.lower-row{grid-template-columns:1fr;}
        .kpi-row{grid-template-columns:repeat(2,1fr);}
    }
    @@media(max-width:780px){
        .kpi-row{grid-template-columns:1fr;}
        .action-grid{grid-template-columns:1fr 1fr;}
        .donut-wrap{flex-direction:column;align-items:flex-start;}
    }
</style>
}

<div class="kpi-row">
    <div class="kpi">
        <div class="kpi-lbl">Net Profit</div>
        <div class="kpi-val">@FmtMoney(profit)</div>
        <div class="kpi-delta @(pctProfit >= 0 ? "up" : "down")">
            <i class="fas fa-arrow-@(pctProfit >= 0 ? "up" : "down")"></i>
            @Math.Abs(pctProfit).ToString("F1", inv)%
            <span class="vs">vs last month</span>
        </div>
        @Html.Raw(Sparkline(Model.SparkProfit, "#2D6A4F"))
    </div>

    <div class="kpi">
        <div class="kpi-lbl">Income</div>
        <div class="kpi-val">@FmtMoney(Model.TotalEarned)</div>
        <div class="kpi-delta @(pctIncome >= 0 ? "up" : "down")">
            <i class="fas fa-arrow-@(pctIncome >= 0 ? "up" : "down")"></i>
            @Math.Abs(pctIncome).ToString("F1", inv)%
            <span class="vs">vs last month</span>
        </div>
        @Html.Raw(Sparkline(Model.SparkIncome, "#52B788"))
    </div>

    <div class="kpi">
        <div class="kpi-lbl">Expenses</div>
        <div class="kpi-val">@FmtMoney(Model.TotalSpent)</div>
        <div class="kpi-delta @(pctExpense <= 0 ? "up" : "down")">
            <i class="fas fa-arrow-@(pctExpense <= 0 ? "down" : "up")"></i>
            @Math.Abs(pctExpense).ToString("F1", inv)%
            <span class="vs">vs last month</span>
        </div>
        @Html.Raw(Sparkline(Model.SparkExpense, "#E89A3C"))
    </div>

    <div class="kpi">
        <div class="kpi-lbl">Cash Balance</div>
        <div class="kpi-val">@FmtMoney(Model.Balance)</div>
        <div class="kpi-delta @(pctBalance >= 0 ? "up" : "down")">
            <i class="fas fa-arrow-@(pctBalance >= 0 ? "up" : "down")"></i>
            @Math.Abs(pctBalance).ToString("F1", inv)%
            <span class="vs">vs last month</span>
        </div>
        @Html.Raw(Sparkline(Model.SparkBalance, "#2D6A4F"))
    </div>
</div>

<div class="content-row">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3>Cash flow</h3>
                <div class="hd-sub">Income and expenses over the last 6 months</div>
            </div>
            <a class="hd-link" asp-controller="Statistics" asp-action="Index">
                Last 6 months <i class="fas fa-chevron-right"></i>
            </a>
        </div>

        <div class="flow-legend">
            <span class="lg"><span class="chip in"></span> Income</span>
            <span class="lg"><span class="chip out"></span> Expenses</span>
        </div>

        <div class="flow-chart">
            <div class="flow-yaxis">
                <span>0</span>
                <span>@((flowMax/4).ToString("N0", inv))</span>
                <span>@((flowMax/2).ToString("N0", inv))</span>
                <span>@(((flowMax*3)/4).ToString("N0", inv))</span>
                <span>@(flowMax.ToString("N0", inv))</span>
            </div>
            <div class="flow-bars">
                @foreach (var p in Model.Flow)
                {
                    var hIn  = flowMax > 0 ? (double)p.Income  / (double)flowMax * 100 : 0;
                    var hOut = flowMax > 0 ? (double)p.Expense / (double)flowMax * 100 : 0;
                    <div class="bar-group">
                        <div class="bar-pair">
                            <div class="bar in"  style="height:@Fmt(hIn)%;"  title="Income: @FmtMoney(p.Income)"></div>
                            <div class="bar out" style="height:@Fmt(hOut)%;" title="Expenses: @FmtMoney(p.Expense)"></div>
                        </div>
                        <div class="bar-label">@p.Label</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-hd">
            <div>
                <h3>Expense breakdown</h3>
                <div class="hd-sub">Top 5 purchase categories</div>
            </div>
        </div>

        <div class="donut-wrap">
            <div class="donut-svg-wrap">
                <svg width="160" height="160" viewBox="0 0 42 42">
                    <circle cx="21" cy="21" r="15.915" fill="transparent" stroke="#F1EFE8" stroke-width="5"/>
                    @if (breakdownTotal > 0)
                    {
                        foreach (var d in donutSegments)
                        {
                            <circle cx="21" cy="21" r="15.915" fill="transparent"
                                    stroke="@d.Color" stroke-width="5"
                                    stroke-dasharray="@Fmt(d.Seg) @Fmt(100 - d.Seg)"
                                    stroke-dashoffset="@Fmt(d.Offset)"
                                    stroke-linecap="butt"/>
                        }
                    }
                </svg>
                <div class="donut-center">
                    <div>
                        <div class="v">@FmtMoney(breakdownTotal)</div>
                        <div class="l">Total</div>
                    </div>
                </div>
            </div>

            <div class="donut-legend">
                @if (Model.Breakdown.Any())
                {
                    foreach (var s in Model.Breakdown)
                    {
                        <div class="lg-row">
                            <span class="chip" style="background:@s.Color;"></span>
                            <span class="nm">@s.Name</span>
                            <span class="pc">@s.Percent.ToString("F0", inv)%</span>
                        </div>
                    }
                }
                else
                {
                    <div class="small-empty" style="padding:8px 0;">
                        <i class="far fa-chart-pie"></i>
                        <div>No expenses yet</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="lower-row">
    <div class="card">
        <div class="card-hd">
            <div>
                <h3>Quick actions</h3>
                <div class="hd-sub">Most common operations</div>
            </div>
        </div>
        <div class="action-grid">
            <a class="action-tile" asp-controller="Seller" asp-action="Index">
                <div class="tile-icon"><i class="fas fa-cart-plus"></i></div>
                <div>
                    <div class="tile-label">New purchase</div>
                    <div class="tile-desc">Buy products from a seller</div>
                </div>
            </a>
            <a class="action-tile" asp-controller="Store" asp-action="Index">
                <div class="tile-icon"><i class="fas fa-tag"></i></div>
                <div>
                    <div class="tile-label">Record sale</div>
                    <div class="tile-desc">Sell products from a store</div>
                </div>
            </a>
            <a class="action-tile" asp-controller="Invoice" asp-action="Index">
                <div class="tile-icon"><i class="far fa-file-lines"></i></div>
                <div>
                    <div class="tile-label">New invoice</div>
                    <div class="tile-desc">Create an invoice for a client</div>
                </div>
            </a>
            <a class="action-tile" asp-controller="User" asp-action="Index" asp-route-id="@Model.UserId">
                <div class="tile-icon"><i class="fas fa-plus-circle"></i></div>
                <div>
                    <div class="tile-label">Add funds</div>
                    <div class="tile-desc">Top up your account balance</div>
                </div>
            </a>
            <a class="action-tile" asp-controller="Statistics" asp-action="Index">
                <div class="tile-icon"><i class="fas fa-chart-bar"></i></div>
                <div>
                    <div class="tile-label">Reports</div>
                    <div class="tile-desc">Sales and profit analytics</div>
                </div>
            </a>
            <a class="action-tile" href="/Export/Transactions?userId=@Model.UserId">
                <div class="tile-icon"><i class="fas fa-file-export"></i></div>
                <div>
                    <div class="tile-label">Export</div>
                    <div class="tile-desc">Download an Excel report</div>
                </div>
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-hd">
            <div>
                <h3>Recent activity</h3>
                <div class="hd-sub">Latest transactions</div>
            </div>
            <a class="hd-link" asp-controller="User" asp-action="ProductsTransaction" asp-route-id="@Model.UserId">
                See all <i class="fas fa-chevron-right"></i>
            </a>
        </div>
        @if (Model.LastTransactions != null && Model.LastTransactions.Any())
        {
            foreach (var t in Model.LastTransactions)
            {
                var cls   = t.typeofAction == "Add" ? "buy" : (t.typeofAction == "Sale" ? "sale" : "dep");
                var amCls = t.typeofAction == "Add" ? "neg" : (t.typeofAction == "Sale" ? "pos" : "dep");
                var sign  = t.typeofAction == "Add" ? "−" : "+";
                var icon  = t.typeofAction == "Add" ? "fa-cart-arrow-down" : (t.typeofAction == "Sale" ? "fa-tag" : "fa-piggy-bank");
                <div class="activity-item">
                    <div class="act-icon @cls"><i class="fas @icon"></i></div>
                    <div class="act-info">
                        <div class="act-name">@t.ProductName</div>
                        <div class="act-date">@t.SoldDate.ToString("dd MMM yyyy", enCulture)@(!string.IsNullOrEmpty(t.StoreName) ? " · " + t.StoreName : "")</div>
                    </div>
                    <div class="act-amt @amCls">@sign@FmtMoney(t.Total)</div>
                </div>
            }
        }
        else
        {
            <div class="small-empty">
                <i class="fas fa-inbox"></i>
                <div>No transactions yet</div>
            </div>
        }
    </div>
</div>
